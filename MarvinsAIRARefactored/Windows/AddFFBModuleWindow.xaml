<Window x:Class="MarvinsAIRARefactored.Windows.AddFFBModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MarvinsAIRARefactored.Converters"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title="{Binding Localization[AddModule]}"
        Icon="/Artwork/AppIcon/maira-universal.ico"
        Width="420"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

	<!-- Pick-and-go module picker: clicking a module type adds it and closes the window immediately; the
	     title-bar X (or Escape) cancels. Rows whose Key starts with an underscore are the non-selectable
	     category headers (same convention as the MairaComboBox grouped dropdown). -->

	<Window.DataContext>
		<Binding Source="{x:Static datacontext:DataContext.Instance}" />
	</Window.DataContext>

	<Window.Resources>

		<converters:StartsWithUnderscoreConverter x:Key="StartsWithUnderscoreConverter" />

		<Style TargetType="ListBox">
			<Setter Property="Background" Value="{DynamicResource Brush.Background.Popup}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		</Style>

		<Style TargetType="ListBoxItem">
			<Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bg"
						        Background="Transparent"
						        BorderBrush="{DynamicResource Brush.Border.Normal}"
						        BorderThickness="0,0,0,1"
						        Padding="12,8">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ListItem.Hover}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<EventSetter Event="PreviewMouseLeftButtonUp" Handler="ModuleTypeItem_PreviewMouseLeftButtonUp" />
			<Style.Triggers>
				<!-- category header rows: not clickable, accent-colored, with breathing room above (the template
				     is replaced so the disabled gray-out cannot override the accent color) -->
				<DataTrigger Binding="{Binding Key, Converter={StaticResource StartsWithUnderscoreConverter}}"
				             Value="True">
					<Setter Property="IsEnabled" Value="False" />
					<Setter Property="Focusable" Value="False" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<TextBlock Text="{Binding Value}"
								           FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
								           FontSize="18"
								           Foreground="{DynamicResource Brush.Accent}"
								           FontWeight="Bold"
								           Margin="12,14,12,4" />
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</DataTrigger>
			</Style.Triggers>
		</Style>

	</Window.Resources>

	<Grid Margin="20">

		<ListBox x:Name="ModuleTypes_ListBox">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Value}"
					           FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
					           FontSize="18"
					           Foreground="{DynamicResource Brush.Foreground.Primary}"
					           TextTrimming="CharacterEllipsis" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

	</Grid>

</Window>
