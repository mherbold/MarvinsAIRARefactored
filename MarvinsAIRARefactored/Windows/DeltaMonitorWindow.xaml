<Window x:Class="MarvinsAIRARefactored.Windows.DeltaMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarvinsAIRARefactored.Windows"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        xmlns:converters="clr-namespace:MarvinsAIRARefactored.Converters"
        mc:Ignorable="d"
        Title="MAIRA - Delta Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        LocationChanged="Window_LocationChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        Cursor="SizeAll">

    <Window.Resources>
        <converters:BooleanToVisibilityHiddenConverter x:Key="BoolToVis" />
        <!-- DeltaMonitorWindow always has a black background, so force light text/icon colors regardless of theme -->
        <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#ffffff" />
        <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#eeeeee" />
        <SolidColorBrush x:Key="Brush.Border.Normal" Color="#aaaaaa" />
        <SolidColorBrush x:Key="Brush.Border.Hover" Color="#ffffff" />
        <SolidColorBrush x:Key="Brush.Border.Active" Color="#ff5b2e" />
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </Window.DataContext>

    <Grid>

        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform"
                            ScaleX="{Binding Settings.OverlaysDeltaMonitorWindowScale}"
                            ScaleY="{Binding Settings.OverlaysDeltaMonitorWindowScale}" />
        </Grid.LayoutTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DeltaMonitor_Title"
                   Style="{StaticResource MairaTextBlockStyle}"
                   Grid.Row="0"
                   Grid.Column="0"
                   Text="{Binding Localization[DeltaMonitor]}"
                   Visibility="{Binding Settings.OverlaysShowDeltaMonitorTitle, Converter={StaticResource BoolToVis}}"
                   HorizontalAlignment="Center"
                   FontSize="30" />

        <Border Grid.Row="1"
                BorderThickness="2"
                BorderBrush="White"
                Background="Black"
                CornerRadius="10"
                Padding="10,10,10,10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Text="{Binding Localization[DeltaMonitorLapTime]}" />

                <TextBlock x:Name="LapTimeText"
                           Grid.Row="0"
                           Grid.Column="2"
                           Style="{StaticResource MairaTextBlockStyle}"
                           HorizontalAlignment="Right"
                           FontSize="30"
                           d:Text="1:23.45" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Text="{Binding Localization[DeltaMonitorVsLastLap]}" />

                <TextBlock x:Name="SelfDeltaText"
                           Grid.Row="2"
                           Grid.Column="2"
                           Style="{StaticResource MairaTextBlockStyle}"
                           HorizontalAlignment="Right"
                           FontSize="30"
                           d:Text="-0.12s" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Text="{Binding Localization[DeltaMonitorVsLeader]}" />

                <TextBlock x:Name="LeaderDeltaText"
                           Grid.Row="4"
                           Grid.Column="2"
                           Style="{StaticResource MairaTextBlockStyle}"
                           HorizontalAlignment="Right"
                           FontSize="30"
                           d:Text="+0.34s" />

            </Grid>

        </Border>

        <Border x:Name="ScaleIcon"
                Grid.Row="0"
                Grid.RowSpan="2"
                Margin="0,0,6,6"
                Padding="4"
                CornerRadius="6"
                Background="Black"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                Visibility="Collapsed">
            <Rectangle Width="28"
                       Height="28"
                       Fill="#ff5b2e"
                       IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="/MarvinsAIRARefactored;component/Artwork/Buttons/solo.png"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Border>

    </Grid>

</Window>
