<Window x:Class="MarvinsAIRARefactored.Windows.ChooseRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title="{Binding Localization[ChooseRecording]}"
        Icon="/Artwork/AppIcon/maira-universal.ico"
        Width="600"
        Height="480"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

	<Window.DataContext>
		<Binding Source="{x:Static datacontext:DataContext.Instance}" />
	</Window.DataContext>

	<Window.Resources>

		<Style TargetType="ListBox">
			<Setter Property="Background" Value="{DynamicResource Brush.Background.Popup}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		</Style>

		<Style TargetType="ListBoxItem">
			<Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="Bg"
						        Background="Transparent"
						        BorderBrush="{DynamicResource Brush.Border.Normal}"
						        BorderThickness="0,0,0,1"
						        Padding="12,8">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.ListItem.Hover}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Accent.Blue}" />
								<Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Window.Resources>

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="20" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<ListBox x:Name="Recordings_ListBox"
		         Grid.Row="0"
		         MouseDoubleClick="Recordings_ListBox_MouseDoubleClick">

			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Value}"
					           FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
					           FontSize="18"
					           Foreground="{DynamicResource Brush.Foreground.Primary}"
					           TextTrimming="CharacterEllipsis" />
				</DataTemplate>
			</ListBox.ItemTemplate>

		</ListBox>

		<TextBlock x:Name="NoRecordings_TextBlock"
		           Grid.Row="0"
		           Text="{Binding Localization[NoRecordingsFound]}"
		           HorizontalAlignment="Center"
		           VerticalAlignment="Center"
		           FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
		           FontSize="18"
		           Foreground="{DynamicResource Brush.Foreground.Muted}"
		           IsHitTestVisible="False"
		           Visibility="Collapsed" />

		<Grid Grid.Row="2"
		      HorizontalAlignment="Center">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="20" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<controls:MairaButton Grid.Column="0"
			                      LabelOnRight="True"
			                      IsSmall="True"
			                      Label="{Binding Localization[OK]}"
			                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/ok.png"
			                      Click="OK_MairaButton_Click" />

			<controls:MairaButton Grid.Column="2"
			                      LabelOnRight="True"
			                      IsSmall="True"
			                      Label="{Binding Localization[Cancel]}"
			                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
			                      Click="Cancel_MairaButton_Click" />

		</Grid>

	</Grid>

</Window>
