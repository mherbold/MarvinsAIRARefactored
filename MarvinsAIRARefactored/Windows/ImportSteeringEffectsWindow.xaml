<Window x:Class="MarvinsAIRARefactored.Windows.ImportSteeringEffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title="{Binding Localization[ImportSteeringEffectsTitle]}"
        Icon="/Artwork/AppIcon/maira-universal.ico"
        Width="680"
        Height="680"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </Window.DataContext>

    <!-- The import summary: every picked file with the car it is for and what importing it will do (or why it
         cannot be imported), the option to bring the FFB graph node settings along, the settings that will be
         switched to per car, and Import / Cancel. Nothing changes until Import is clicked. -->

    <Window.Resources>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Popup}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Primary}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border.Normal}"
                                BorderThickness="0,0,0,1"
                                Padding="12,8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Localization[ImportSteeringEffectsMessage]}"
                   Style="{StaticResource MairaTextBlockStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <ListBox x:Name="Files_ListBox"
                 Grid.Row="1">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>

                        <TextBlock Text="{Binding CarLabel}"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Foreground.Muted}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{Binding StatusBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding Warnings}"
                                   Visibility="{Binding WarningsVisibility}"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Status.Warning.Text}"
                                   TextWrapping="Wrap" />

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- The switch's own label never wraps (its layout gives the label unlimited width), and this one is long,
             so the label is a wrapping text beside an unlabeled switch - clicking it toggles the switch too. -->
        <Grid x:Name="IncludeGraphNodes_Grid"
              Grid.Row="2"
              Margin="0,16,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:MairaSwitch x:Name="IncludeGraphNodes_MairaSwitch"
                                  Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Toggled="IncludeGraphNodes_MairaSwitch_Toggled" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Localization[ImportSteeringEffectsGraphNodes]}"
                       Style="{StaticResource MairaTextBlockStyle}"
                       Foreground="{DynamicResource Brush.Foreground.Primary}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Cursor="Hand"
                       MouseDown="IncludeGraphNodes_TextBlock_MouseDown" />

        </Grid>

        <TextBlock x:Name="ScopeChanges_TextBlock"
                   Grid.Row="3"
                   Style="{StaticResource MairaTextBlockStyle}"
                   Foreground="{DynamicResource Brush.Status.Warning.Text}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="Collapsed" />

        <Grid Grid.Row="4"
              Margin="0,20,0,0"
              HorizontalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:MairaButton x:Name="Import_MairaButton"
                                  Grid.Column="0"
                                  LabelOnRight="True"
                                  IsSmall="True"
                                  Label="{Binding Localization[ImportSteeringEffectsButton]}"
                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/import.png"
                                  Click="Import_MairaButton_Click" />

            <controls:MairaButton Grid.Column="2"
                                  LabelOnRight="True"
                                  IsSmall="True"
                                  Label="{Binding Localization[Cancel]}"
                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                  Click="Cancel_MairaButton_Click" />

        </Grid>

    </Grid>

</Window>
