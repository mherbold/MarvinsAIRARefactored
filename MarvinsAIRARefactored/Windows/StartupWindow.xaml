<Window x:Class="MarvinsAIRARefactored.Windows.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title=""
        Width="836"
        Height="470"
        MinWidth="836"
        MinHeight="470"
        MaxWidth="836"
        MaxHeight="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="/Artwork/AppIcon/maira-universal.ico">

  <Window.DataContext>
    <Binding Source="{x:Static datacontext:DataContext.Instance}" />
  </Window.DataContext>

  <Border Background="Transparent"
          CornerRadius="80"
          ClipToBounds="True">

    <Grid>
      <Grid.Clip>
        <RectangleGeometry RadiusX="80"
                           RadiusY="80"
                           Rect="0,0,836,470" />
      </Grid.Clip>

      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Image Grid.Row="0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Source="/MarvinsAIRARefactored;component/Artwork/Misc/splash-screen.png"
             Stretch="Fill"
             RenderOptions.BitmapScalingMode="HighQuality"/>

      <Grid Grid.Row="0">

        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="60"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Version_TextBlock"
                   Grid.Row="1"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Style="{StaticResource MairaTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text=""
                   FontSize="18"
                   Foreground="{DynamicResource Brush.Accent}"
                   d:Text="Version number goes here"/>

        <controls:MairaProgressBar x:Name="Startup_MairaProgressBar"
                                   Grid.Row="3"
                                   Margin="250,0,250,0"
                                   ShowPercentageText="False"
                                   ShowLabel="False"
                                   ProgressBarHeight="15"
                                   UseNearCompletionAccent="False"/>

        <TextBlock x:Name="Status_TextBlock"
                   Grid.Row="5"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Style="{StaticResource MairaTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="{Binding Localization[StartupWindowTitle]}"/>

      </Grid>

    </Grid>

  </Border>

</Window>
