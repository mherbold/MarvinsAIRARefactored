<Window x:Class="MarvinsAIRARefactored.Windows.GripOMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MarvinsAIRARefactored.Windows"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        xmlns:converters="clr-namespace:MarvinsAIRARefactored.Converters"
        mc:Ignorable="d"
        Title="MAIRA - Grip-O-Meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        LocationChanged="Window_LocationChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <converters:BooleanToVisibilityHiddenConverter x:Key="BoolToVis" />
        <!-- GripOMeterWindow is a transparent overlay, so force light text color regardless of theme -->
        <SolidColorBrush x:Key="Brush.Foreground.Primary" Color="#ffffff" />
        <SolidColorBrush x:Key="Brush.Foreground.Secondary" Color="#eeeeee" />
    </Window.Resources>

    <Window.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </Window.DataContext>

    <!-- Force the gauge to stay LTR even under RTL languages: the ball position encodes lateral G
         direction (left/right is physically meaningful) and the edit-mode icons are pinned to the
         right edge, so mirroring would invert the reading and misplace the controls. -->
    <Grid FlowDirection="LeftToRight">

        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform"
                            ScaleX="{Binding Settings.OverlaysGripOMeterWindowScale}"
                            ScaleY="{Binding Settings.OverlaysGripOMeterWindowScale}" />
        </Grid.LayoutTransform>

        <!-- gauge content, grouped separately from the edit-mode buttons -->
        <Grid x:Name="GaugeContent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="8" />
                <RowDefinition Height="80" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="GripOMeter_Title"
                       Style="{StaticResource MairaTextBlockStyle}"
                       Grid.Row="0"
                       Grid.Column="0"
                       Text="{Binding Localization[GripOMeter]}"
                       Visibility="{Binding Settings.OverlaysShowGripOMeterTitle, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Center"
                       FontSize="30" />

            <Border x:Name="GripOMeter_Background"
                    Grid.Row="2"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Width="384"
                    Height="96"
                    CornerRadius="48"
                    BorderThickness="4"
                    BorderBrush="Black" />

            <Border Grid.Row="2"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Width="96"
                    Height="96"
                    CornerRadius="48"
                    BorderThickness="4"
                    BorderBrush="Black" />

            <Border Grid.Row="3"
                    Grid.Column="0"
                    Background="Black"
                    Width="80"
                    Height="80"
                    CornerRadius="40">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="GripOMeter_Ball_Transform" />
                </Border.RenderTransform>

            </Border>

            <Border Grid.Row="3"
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="5"
                    Width="40"
                    Height="40"
                    CornerRadius="20">

                <Border.RenderTransform>
                    <TranslateTransform x:Name="GripOMeter_SeatOfPants_Transform" />
                </Border.RenderTransform>

            </Border>

        </Grid>

        <Border x:Name="GearIcon"
                Margin="0,0,90,6"
                Padding="4"
                CornerRadius="6"
                Background="Black"
                BorderBrush="#ff5b2e"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                Visibility="Collapsed">
            <Grid Width="28"
                  Height="28"
                  IsHitTestVisible="False">
                <Viewbox Width="21"
                         Height="21"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#ff5b2e" />
                </Viewbox>
            </Grid>
        </Border>

        <Border x:Name="DragIcon"
                Margin="0,0,48,6"
                Padding="4"
                CornerRadius="6"
                Background="Black"
                BorderBrush="#ff5b2e"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeAll"
                Visibility="Collapsed">
            <Grid Width="28"
                  Height="28"
                  IsHitTestVisible="False">
                <Viewbox Width="24"
                         Height="24"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Data="M16,1 L22,7 L17.5,7 L17.5,14.5 L25,14.5 L25,10 L31,16 L25,22 L25,17.5 L17.5,17.5 L17.5,25 L22,25 L16,31 L10,25 L14.5,25 L14.5,17.5 L7,17.5 L7,22 L1,16 L7,10 L7,14.5 L14.5,14.5 L14.5,7 L10,7 Z"
                          Fill="#ff5b2e" />
                </Viewbox>
            </Grid>
        </Border>

        <Border x:Name="ScaleIcon"
                Margin="0,0,6,6"
                Padding="4"
                CornerRadius="6"
                Background="Black"
                BorderBrush="#ff5b2e"
                BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="SizeNWSE"
                Visibility="Collapsed">
            <Rectangle Width="28"
                       Height="28"
                       Fill="#ff5b2e"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="/MarvinsAIRARefactored;component/Artwork/Buttons/solo.png" />
                </Rectangle.OpacityMask>
            </Rectangle>
        </Border>

    </Grid>

</Window>
