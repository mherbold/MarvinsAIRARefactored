<Window x:Class="MarvinsAIRARefactored.Windows.EditDescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title="{Binding Localization[EditDescriptionTitle]}"
        Icon="/Artwork/AppIcon/maira-universal.ico"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner">

	<!-- Free-form description editor, shared by the graph description and the node descriptions (the caller
	     seeds the text and reads it back on confirm). Multi-line: Enter inserts a newline; commit is the OK
	     button only. -->

	<Window.DataContext>
		<Binding Source="{x:Static datacontext:DataContext.Instance}" />
	</Window.DataContext>

	<StackPanel Margin="20">

		<controls:MairaTextBox x:Name="Description_MairaTextBox"
		                       IsMultiLine="True"
		                       FontSize="20" />

		<Grid Margin="0,20,0,0"
		      HorizontalAlignment="Center">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="20" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<controls:MairaButton Grid.Column="0"
			                      LabelOnRight="True"
			                      IsSmall="True"
			                      Label="{Binding Localization[OK]}"
			                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/ok.png"
			                      Click="OK_MairaButton_Click" />

			<controls:MairaButton Grid.Column="2"
			                      LabelOnRight="True"
			                      IsSmall="True"
			                      Label="{Binding Localization[Cancel]}"
			                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
			                      Click="Cancel_MairaButton_Click" />

		</Grid>

	</StackPanel>

</Window>
