<UserControl x:Class="MarvinsAIRARefactored.Controls.FFBGraphEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:converters="clr-namespace:MarvinsAIRARefactored.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="400">

	<!-- Node-graph editor for the FFB graph: one draggable box per main-signal module, with bezier wires
	     connecting module outputs to inputs. Clicking a node selects it (the settings panel and preview follow);
	     re-wiring happens by dragging from a connector dot to a compatible dot on another node, or via the input
	     combos on the selected module's settings panel. -->

	<UserControl.Resources>
		<converters:BooleanToVisibilityCollapsedConverter x:Key="BoolToVisibilityCollapsed" />
		<converters:InverseBooleanToVisibilityCollapsedConverter x:Key="InverseBoolToVisibilityCollapsed" />
	</UserControl.Resources>

	<!-- Rounded on top only and no bottom border: the preview graph sits flush underneath (its top border is
	     the 2px divider between them), so the two boxes read as one view. -->
	<Border BorderThickness="2,2,2,0"
	        BorderBrush="{DynamicResource Brush.Border.Normal}"
	        Background="{DynamicResource Brush.Background.Popup}"
	        CornerRadius="5,5,0,0"
	        ClipToBounds="True">

		<Grid>

			<!-- Fixed-height viewport, sized to match the preview graph's 301px image. It is a Canvas rather than a
			     Grid so the (much larger) node canvas inside cannot drive the layout width. Pan and zoom are a
			     RenderTransform on the content, so there is no scroll viewer and no scroll bar. The transparent
			     background is what lets empty space hit-test for the right-drag pan. -->
			<Canvas x:Name="Viewport_Canvas"
			        Height="301"
			        Background="Transparent"
			        ClipToBounds="True"
			        PreviewMouseWheel="Viewport_Canvas_PreviewMouseWheel"
			        MouseRightButtonDown="Viewport_Canvas_MouseRightButtonDown"
			        MouseMove="Viewport_Canvas_MouseMove"
			        MouseRightButtonUp="Viewport_Canvas_MouseRightButtonUp"
			        LostMouseCapture="Viewport_Canvas_LostMouseCapture"
			        SizeChanged="Viewport_Canvas_SizeChanged">

			<Grid x:Name="LayoutRoot_Grid">

				<Grid.RenderTransform>
					<TransformGroup>
						<ScaleTransform x:Name="Zoom_ScaleTransform" />
						<TranslateTransform x:Name="Pan_TranslateTransform" />
					</TransformGroup>
				</Grid.RenderTransform>

				<Canvas x:Name="Wires_Canvas"
				        IsHitTestVisible="False" />

			<ItemsControl x:Name="Nodes_ItemsControl">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<Canvas />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemContainerStyle>
					<Style TargetType="ContentPresenter">
						<Setter Property="Canvas.Left" Value="{Binding NodeX}" />
						<Setter Property="Canvas.Top" Value="{Binding NodeY}" />
					</Style>
				</ItemsControl.ItemContainerStyle>

				<ItemsControl.ItemTemplate>
					<DataTemplate>

						<Grid Width="170"
						      Height="54"
						      Background="Transparent"
						      Cursor="Hand"
						      MouseLeftButtonDown="Node_MouseLeftButtonDown"
						      MouseRightButtonDown="Node_MouseRightButtonDown"
						      MouseMove="Node_MouseMove"
						      MouseLeftButtonUp="Node_MouseLeftButtonUp">

							<Border CornerRadius="6"
							        Margin="5,0"
							        Background="{DynamicResource Brush.Background.Default}"
							        BorderThickness="2">

								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Normal}" />
										<Setter Property="Opacity" Value="1" />
										<Style.Triggers>
											<!-- preview lock (right-click) renders below selection: when the same
											     node is both, the selection accent wins (last matching trigger) -->
											<DataTrigger Binding="{Binding IsPreviewLocked}" Value="True">
												<Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsSelected}" Value="True">
												<Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding Enabled}" Value="False">
												<Setter Property="Opacity" Value="0.45" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>

								<StackPanel VerticalAlignment="Center"
								            Margin="10,0">

									<TextBlock Text="{Binding DisplayName}"
									           Style="{StaticResource MairaTextBlockStyle}"
									           FontSize="16"
									           TextTrimming="CharacterEllipsis"
									           TextAlignment="Center" />

									<!-- live settings digest ("1.50x" / "one pole, 12.5 Hz") — collapsed when the
									     module has no settings, so the name re-centers vertically -->
									<TextBlock Text="{Binding SettingsSummary}"
									           FontSize="11"
									           Opacity="0.6"
									           TextTrimming="CharacterEllipsis"
									           TextAlignment="Center">
										<TextBlock.Style>
											<Style TargetType="TextBlock"
											       BasedOn="{StaticResource MairaTextBlockStyle}">
												<Style.Triggers>
													<DataTrigger Binding="{Binding SettingsSummary}" Value="">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>

								</StackPanel>

							</Border>

							<!-- input connector A (upper-left on dual-input modules, centered otherwise) -->
							<Ellipse Width="10"
							         Height="10"
							         Fill="{DynamicResource Brush.Border.Active}"
							         Stroke="{DynamicResource Brush.Background.Popup}"
							         StrokeThickness="1"
							         HorizontalAlignment="Left"
							         Visibility="{Binding ShowInputA, Converter={StaticResource BoolToVisibilityCollapsed}}">
								<Ellipse.Style>
									<Style TargetType="Ellipse">
										<Setter Property="VerticalAlignment" Value="Center" />
										<Setter Property="Margin" Value="0" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding ShowInputB}" Value="True">
												<Setter Property="VerticalAlignment" Value="Top" />
												<Setter Property="Margin" Value="0,13,0,0" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Ellipse.Style>
							</Ellipse>

							<!-- input connector B (lower-left, dual-input modules only) -->
							<Ellipse Width="10"
							         Height="10"
							         Fill="{DynamicResource Brush.Border.Active}"
							         Stroke="{DynamicResource Brush.Background.Popup}"
							         StrokeThickness="1"
							         HorizontalAlignment="Left"
							         VerticalAlignment="Bottom"
							         Margin="0,0,0,13"
							         Visibility="{Binding ShowInputB, Converter={StaticResource BoolToVisibilityCollapsed}}" />

							<!-- output connector (right, hidden on the Output module) -->
							<Ellipse Width="10"
							         Height="10"
							         Fill="{DynamicResource Brush.Border.Active}"
							         Stroke="{DynamicResource Brush.Background.Popup}"
							         StrokeThickness="1"
							         HorizontalAlignment="Right"
							         VerticalAlignment="Center"
							         Visibility="{Binding IsOutput, Converter={StaticResource InverseBoolToVisibilityCollapsed}}" />

						</Grid>

					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

			</Grid>

			</Canvas>

			<!-- canvas tools (pinned to the corner, outside the panned canvas): add module + snap-to-grid toggle + auto layout -->
			<StackPanel Orientation="Horizontal"
			            HorizontalAlignment="Right"
			            VerticalAlignment="Top"
			            Margin="0,8,8,0"
			            Panel.ZIndex="1">

				<local:MairaButton x:Name="AddModule_MairaButton"
				                   Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/plus.png"
				                   IsSmall="True"
				                   Click="AddModule_MairaButton_Click" />

				<local:MairaButton x:Name="SnapToGrid_MairaButton"
				                   Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/grid.png"
				                   IsSmall="True"
				                   Margin="8,0,0,0"
				                   Click="SnapToGrid_MairaButton_Click" />

				<local:MairaButton x:Name="AutoLayout_MairaButton"
				                   Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/wand.png"
				                   IsSmall="True"
				                   Margin="8,0,0,0"
				                   Click="AutoLayout_MairaButton_Click" />

			</StackPanel>

		</Grid>

	</Border>

</UserControl>
