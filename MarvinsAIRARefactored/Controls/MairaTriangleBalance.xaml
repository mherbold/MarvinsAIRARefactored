<UserControl x:Class="MarvinsAIRARefactored.Controls.MairaTriangleBalance"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid VerticalAlignment="Top"
          HorizontalAlignment="Center">

        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled, ElementName=Root}"
                                 Value="False">
                        <Setter Property="Opacity"
                                Value="0.4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Label_TextBlock"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   Text="{Binding Label, ElementName=Root, FallbackValue='Balance'}"
                   PreviewMouseRightButtonDown="Label_TextBlock_PreviewMouseRightButtonDown"
                   TextTrimming="CharacterEllipsis">

            <TextBlock.Style>

                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource MairaTextBlockStyle}">

                    <Setter Property="Visibility"
                            Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Label, ElementName=Root}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </TextBlock.Style>

        </TextBlock>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource MairaTextBlockStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,2"
                   Text="{Binding Localization[Sway]}" />

        <!-- Keep the triangle geometry in LTR regardless of UI direction: the vertex positions are
             mirrored under RTL but the code-behind barycentric math is not, and the surge/heave
             corner assignment is a fixed physical convention. -->
        <Canvas x:Name="Triangle_Canvas"
                Grid.Row="2"
                FlowDirection="LeftToRight"
                Width="200"
                Height="160"
                Background="Transparent"
                MouseLeftButtonDown="Triangle_Canvas_MouseLeftButtonDown"
                MouseMove="Triangle_Canvas_MouseMove"
                MouseLeftButtonUp="Triangle_Canvas_MouseLeftButtonUp"
                LostMouseCapture="Triangle_Canvas_LostMouseCapture"
                PreviewMouseRightButtonDown="Triangle_Canvas_PreviewMouseRightButtonDown"
                PreviewMouseRightButtonUp="Triangle_Canvas_PreviewMouseRightButtonUp"
                MouseLeave="Triangle_Canvas_MouseLeave">

            <Path x:Name="Triangle_Path"
                  Stroke="{DynamicResource Brush.Border.Normal}"
                  StrokeThickness="2"
                  Fill="{DynamicResource Brush.Background.Popup}"
                  StrokeLineJoin="Round"
                  Data="M 100,8 L 8,152 L 192,152 Z" />

            <!-- Static marker at the triangle centroid showing the default (equal-thirds) balance. -->
            <Ellipse x:Name="Default_Dot_Ellipse"
                     Width="6"
                     Height="6"
                     Fill="{DynamicResource Brush.Border.Normal}"
                     IsHitTestVisible="False" />

            <Ellipse x:Name="Dot_Ellipse"
                     Width="14"
                     Height="14"
                     Fill="{DynamicResource Brush.Accent}"
                     IsHitTestVisible="False" />

        </Canvas>

        <Grid Grid.Row="3"
              FlowDirection="LeftToRight"
              Width="200"
              Margin="0,2,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource MairaTextBlockStyle}"
                       HorizontalAlignment="Left"
                       Text="{Binding Localization[Surge]}" />

            <TextBlock Grid.Column="1"
                       Style="{StaticResource MairaTextBlockStyle}"
                       HorizontalAlignment="Right"
                       Text="{Binding Localization[Heave]}" />

        </Grid>

    </Grid>

</UserControl>
