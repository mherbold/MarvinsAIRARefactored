<UserControl x:Class="MarvinsAIRARefactored.Controls.MairaFFBGraphEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:converters="clr-namespace:MarvinsAIRARefactored.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="400">

    <!-- Node-graph editor for the FFB graph: one draggable box per module, with bezier wires connecting module
	     outputs to inputs. Vibration generator modules appear as standalone nodes with no connectors at all —
	     they only feed the vibration bus. Clicking a node selects it (the settings panel and preview follow);
	     re-wiring happens by dragging from a connector dot to a compatible dot on another node, or via the input
	     combos on the selected module's settings panel. -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BoolToVisibilityCollapsed" />
    </UserControl.Resources>

    <!-- Rounded on the upper left only, no bottom border: the module settings column sits flush on the right
		     (this box's right border is that divider) and the preview graph sits flush underneath (its top border is
	     the 2px divider between them), so the two boxes read as one view. -->
    <Border BorderThickness="2,2,2,0"
            BorderBrush="{DynamicResource Brush.Border.Normal}"
            Background="{DynamicResource Brush.Background.Popup}"
            CornerRadius="5,0,0,0"
            ClipToBounds="True">

        <Grid>

            <!-- Height-limited viewport (user-resizable via the grab handle on the seam below; the height persists
			     in settings). It is a Canvas rather than a Grid so the (much larger) node canvas inside cannot
			     drive the layout width. Pan and zoom are a RenderTransform on the content, so there is no scroll
			     viewer and no scroll bar. The transparent background is what lets empty space hit-test for the
			     left-drag pan. -->
            <Canvas x:Name="Viewport_Canvas"
                    Height="{Binding Settings.RacingWheelFFBGraphEditorHeight}"
                    Background="Transparent"
                    ClipToBounds="True"
                    PreviewMouseWheel="Viewport_Canvas_PreviewMouseWheel"
                    MouseLeftButtonDown="Viewport_Canvas_MouseLeftButtonDown"
                    MouseMove="Viewport_Canvas_MouseMove"
                    MouseLeftButtonUp="Viewport_Canvas_MouseLeftButtonUp"
                    LostMouseCapture="Viewport_Canvas_LostMouseCapture"
                    SizeChanged="Viewport_Canvas_SizeChanged">

                <Grid x:Name="LayoutRoot_Grid">

                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Zoom_ScaleTransform" />
                            <TranslateTransform x:Name="Pan_TranslateTransform" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- faint dots marking the snap grid points, shown only while snap-to-grid is on. Lives in
				     content space (behind the wires and nodes) so it pans and zooms with the graph. The tile
				     geometry (viewbox, viewport, dot center) is set in the constructor from the
				     FFBGraphTopology GridSize constant — the values here are placeholders. -->
                    <Rectangle IsHitTestVisible="False"
                               Opacity="0.3"
                               Visibility="{Binding Settings.RacingWheelFFBGraphSnapToGrid, Converter={StaticResource BoolToVisibilityCollapsed}}">
                        <Rectangle.Fill>
                            <DrawingBrush x:Name="GridDots_Brush"
                                          TileMode="Tile"
                                          ViewportUnits="Absolute"
                                          ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="{DynamicResource Brush.Foreground.Muted}">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry x:Name="GridDot_EllipseGeometry"
                                                             RadiusX="1.5"
                                                             RadiusY="1.5" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Canvas x:Name="Wires_Canvas"
                            IsHitTestVisible="False" />

                    <ItemsControl x:Name="Nodes_ItemsControl">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left"
                                        Value="{Binding NodeX}" />
                                <Setter Property="Canvas.Top"
                                        Value="{Binding NodeY}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <!-- node box size and connector metrics come from the MairaFFBGraphEditor constants
							     (via x:Static), which the wire drawing and connector hit-testing share -->
                                <Grid Width="{x:Static local:MairaFFBGraphEditor.NodeWidth}"
                                      Height="{x:Static local:MairaFFBGraphEditor.NodeHeight}"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                      MouseRightButtonDown="Node_MouseRightButtonDown"
                                      MouseMove="Node_MouseMove"
                                      MouseLeftButtonUp="Node_MouseLeftButtonUp">

                                    <!-- hovering a node shows its description (the localized built-in default, or
                                         the user's override on a custom graph); nodes without one get no tooltip -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="ToolTip">
                                                <Setter.Value>
                                                    <ToolTip>
                                                        <TextBlock Text="{Binding NodeDescription}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="360" />
                                                    </ToolTip>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NodeDescription}"
                                                             Value="">
                                                    <Setter Property="ToolTip"
                                                            Value="{x:Null}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- the border fills the whole layout box so a snapped node sits flush on the
							     grid; the connector dots straddle its edges via their negative margins -->
                                    <Border CornerRadius="6"
                                            Background="{DynamicResource Brush.Background.Default}"
                                            BorderThickness="2">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Brush.Border.Normal}" />
                                                <Setter Property="Opacity"
                                                        Value="1" />
                                                <Style.Triggers>
                                                    <!-- vibration generator nodes get a blue default border (the steering
											     effects page's slider blue) so they read apart from the wired
											     chain; declared first, so preview-lock/selection still win -->
                                                    <DataTrigger Binding="{Binding IsGenerator}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Accent.BlueDark}" />
                                                    </DataTrigger>
                                                    <!-- telemetry source nodes green, the output node purple — same tone
												     family as the generator blue, so no role shouts over the others;
												     ordinary chain modules keep the gray default -->
                                                    <DataTrigger Binding="{Binding IsSource}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Accent.GreenDark}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOutput}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Accent.PurpleDark}" />
                                                    </DataTrigger>
                                                    <!-- preview lock (right-click) renders below selection: when the same
											     node is both, the selection accent wins (last matching trigger) -->
                                                    <DataTrigger Binding="{Binding IsPreviewLocked}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Border.Active}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Enabled}"
                                                                 Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.45" />
                                                    </DataTrigger>
                                                    <!-- an understeer/oversteer/seat-of-pants module whose effect is
											     switched off on the steering effects page dims like a disabled
											     module, even while the module itself is enabled -->
                                                    <DataTrigger Binding="{Binding SteeringEffectDisabled}"
                                                                 Value="True">
                                                        <Setter Property="Opacity"
                                                                Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="10,0">

                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource MairaTextBlockStyle}"
                                                       FontSize="16"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center" />

                                            <!-- live settings digest ("1.50x" / "one pole, 12.5 Hz") — collapsed when the
									     module has no settings, so the name re-centers vertically -->
                                            <TextBlock Text="{Binding SettingsSummary}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource MairaTextBlockStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SettingsSummary}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </StackPanel>

                                    </Border>

                                    <!-- input connector A (upper-left on dual-input modules, centered otherwise) -->
                                    <Ellipse Width="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Height="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Fill="{DynamicResource Brush.Border.Active}"
                                             Stroke="{DynamicResource Brush.Background.Popup}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Left"
                                             Visibility="{Binding ShowInputA, Converter={StaticResource BoolToVisibilityCollapsed}}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="VerticalAlignment"
                                                        Value="Center" />
                                                <Setter Property="Margin"
                                                        Value="{x:Static local:MairaFFBGraphEditor.SingleInputConnectorMargin}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowInputB}"
                                                                 Value="True">
                                                        <Setter Property="VerticalAlignment"
                                                                Value="Top" />
                                                        <Setter Property="Margin"
                                                                Value="{x:Static local:MairaFFBGraphEditor.DualInputAConnectorMargin}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- input connector B (lower-left, dual-input modules only) -->
                                    <Ellipse Width="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Height="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Fill="{DynamicResource Brush.Border.Active}"
                                             Stroke="{DynamicResource Brush.Background.Popup}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Bottom"
                                             Margin="{x:Static local:MairaFFBGraphEditor.DualInputBConnectorMargin}"
                                             Visibility="{Binding ShowInputB, Converter={StaticResource BoolToVisibilityCollapsed}}" />

                                    <!-- output connector (right, hidden on the Output module and on the standalone
							     vibration generator nodes) -->
                                    <Ellipse Width="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Height="{x:Static local:MairaFFBGraphEditor.ConnectorDiameter}"
                                             Fill="{DynamicResource Brush.Border.Active}"
                                             Stroke="{DynamicResource Brush.Background.Popup}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             Margin="{x:Static local:MairaFFBGraphEditor.OutputConnectorMargin}"
                                             Visibility="{Binding HasOutputConnector, Converter={StaticResource BoolToVisibilityCollapsed}}" />

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>

            </Canvas>

            <!-- canvas tools (pinned to the corner, outside the panned canvas): add module + remove selected module
			     + snap-to-grid toggle + auto layout -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Panel.ZIndex="1"
                    Background="{DynamicResource Brush.Background.Default}"
                    CornerRadius="20"
                    Padding="6">

                <!-- the rounded plate above is opaque (page background color) so the buttons stay readable
					     over whatever nodes are underneath -->
                <StackPanel Orientation="Horizontal">

                    <local:MairaButton x:Name="AddModule_MairaButton"
                                       Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/plus.png"
                                       IsSmall="True"
                                       Click="AddModule_MairaButton_Click" />

                    <local:MairaButton x:Name="RemoveModule_MairaButton"
                                       Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/minus.png"
                                       IsSmall="True"
                                       Margin="8,0,0,0"
                                       Click="RemoveModule_MairaButton_Click" />

                    <local:MairaButton x:Name="SnapToGrid_MairaButton"
                                       Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/grid.png"
                                       IsSmall="True"
                                       Margin="8,0,0,0"
                                       Click="SnapToGrid_MairaButton_Click" />

                    <local:MairaButton x:Name="AutoLayout_MairaButton"
                                       Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/wand.png"
                                       IsSmall="True"
                                       Margin="8,0,0,0"
                                       Click="AutoLayout_MairaButton_Click" />

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>
