<UserControl x:Class="MarvinsAIRARefactored.Controls.MairaTextBox"
             x:Name="Root"
             FontSize="30"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:classes="clr-namespace:MarvinsAIRARefactored.Classes"
             mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <PasswordBox x:Name="InnerPasswordBox"
                     Grid.Row="1"
                     Height="34"
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Bottom"
                     FontSize="{Binding FontSize, ElementName=Root}"
                     Foreground="{DynamicResource Brush.Accent}"
                     Background="Transparent"
                     CaretBrush="{DynamicResource Brush.Accent}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="0,0,0,2"
                     FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
                     PasswordChanged="InnerPasswordBox_PasswordChanged">

            <PasswordBox.Style>
                <Style TargetType="PasswordBox">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPassword, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValueLeftToRight, ElementName=Root}"
                                     Value="True">
                            <Setter Property="FlowDirection"
                                    Value="LeftToRight" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </PasswordBox.Style>

        </PasswordBox>

        <TextBlock x:Name="TextBlock"
                   Grid.Row="0"
                   Text="{Binding Label, ElementName=Root, FallbackValue='Chatterbox Server Base URL'}">

            <TextBlock.Style>

                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource MairaTextBlockStyle}">

                    <Setter Property="Visibility"
                            Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding Label, ElementName=Root}"
                                     Value="">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </TextBlock.Style>

        </TextBlock>

        <TextBox x:Name="TextBox"
                 Grid.Row="1"
                 FontSize="{Binding FontSize, ElementName=Root}"
                 Foreground="{DynamicResource Brush.Accent}"
                 Background="Transparent"
                 CaretBrush="{DynamicResource Brush.Accent}"
                 BorderBrush="{DynamicResource Brush.Border.Subtle}"
                 BorderThickness="0,0,0,2"
                 FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
                 Text="{Binding Value, ElementName=Root, FallbackValue='Some example text for the text box user control', UpdateSourceTrigger=PropertyChanged}"
                 classes:TextBoxBehaviors.IsNumericOnly="{Binding IsNumericOnly, ElementName=Root}">

            <!-- Height/alignment live in the style (not local attributes) so the IsMultiLine trigger can
                 override them — a local value would always win over a trigger setter -->
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Visibility"
                            Value="Visible" />
                    <Setter Property="Height"
                            Value="34" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="VerticalAlignment"
                            Value="Bottom" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPassword, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValueLeftToRight, ElementName=Root}"
                                     Value="True">
                            <Setter Property="FlowDirection"
                                    Value="LeftToRight" />
                        </DataTrigger>
                        <!-- multi-line mode: a tall wrapping editor where Enter inserts a newline -->
                        <DataTrigger Binding="{Binding IsMultiLine, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Height"
                                    Value="{Binding MultiLineHeight, ElementName=Root}" />
                            <Setter Property="AcceptsReturn"
                                    Value="True" />
                            <Setter Property="TextWrapping"
                                    Value="Wrap" />
                            <Setter Property="VerticalScrollBarVisibility"
                                    Value="Auto" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Top" />
                            <Setter Property="VerticalAlignment"
                                    Value="Stretch" />
                            <Setter Property="Padding"
                                    Value="2,4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>

        </TextBox>

        <!-- Placeholder overlay — visible only when Value is empty and Placeholder is set -->
        <TextBlock x:Name="PlaceholderTextBlock"
                   Grid.Row="1"
                   Padding="2,0,0,0"
                   IsHitTestVisible="False"
                   Text="{Binding Placeholder, ElementName=Root}"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   FontFamily="pack://application:,,,/MarvinsAIRARefactored;component/Fonts/#Aptos Narrow"
                   Foreground="{DynamicResource Brush.Accent}"
                   Opacity="0.35">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Style.Triggers>
                        <!-- multi-line mode: the placeholder sits at the top like the first line of text would -->
                        <DataTrigger Binding="{Binding IsMultiLine, ElementName=Root}"
                                     Value="True">
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Margin" Value="0,4,0,0" />
                        </DataTrigger>
                        <!-- Show when Value is empty, not a password box, and not focused -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value, ElementName=Root}" Value="" />
                                <Condition Binding="{Binding IsPassword, ElementName=Root}" Value="False" />
                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Root}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsValueLeftToRight, ElementName=Root}"
                                     Value="True">
                            <Setter Property="FlowDirection"
                                    Value="LeftToRight" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

    </Grid>

</UserControl>
