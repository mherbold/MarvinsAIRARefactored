<UserControl x:Class="MarvinsAIRARefactored.Controls.MairaAppMenuPopup"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>

        <DataTemplate x:Key="AppMenuItemTemplate">

            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    CornerRadius="5"
                    Margin="5,0"
                    PreviewMouseLeftButtonUp="MenuItem_PreviewMouseLeftButtonUp"
                    Cursor="Hand">

                <Border.Style>

                    <Style TargetType="Border">

                        <Setter Property="Background"
                                Value="Transparent" />

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Brush.ListItem.Hover}" />
                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </Border.Style>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                            BorderThickness="2,0,0,0"
                            Margin="0,10">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="BorderBrush"
                                        Value="Transparent" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource Brush.ComboItem.Stripe}" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource Brush.Accent}" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                    </Border>

                    <TextBlock Grid.Column="3"
                               Style="{StaticResource MairaTextBlockStyle}"
                               FontSize="30"
                               Foreground="{DynamicResource Brush.Foreground.Secondary}"
                               Padding="0,5">
                        <Run Text="{Binding DisplayName}" />
                        <Run Text="{Binding Suffix}"
                             Foreground="{DynamicResource Brush.GroupBox.SubLabel}" />
                    </TextBlock>

                </Grid>

            </Border>

        </DataTemplate>

    </UserControl.Resources>

    <Grid>

        <Border Background="#000"
                Opacity="0.75"
                MouseDown="Scrim_MouseDown" />

        <!-- The menu card lives in a Popup so it renders in its own top-level window and is no longer
             clipped to (or squeezed by) the main window. When the main window is narrower than the menu,
             the three columns now overflow past the window edges instead of being cut off. The scrim
             above still fills the main window; only the card is free to extend beyond it. The Popup
             already inherits the main window's AppUIScale because WPF applies the PlacementTarget's
             visual-ancestor transforms to the popup content, so we must NOT re-apply that scale here
             (doing so scaled the card by AppUIScale squared, making it too small below 100%).

             The card is anchored to the hamburger button (PlacementTarget set by MainWindow) with
             Placement="Bottom", which puts the card's top-left corner at the button's bottom-left corner
             (so the card's left edge lines up with the button's left edge). A Popup ignores its child's
             Margin when positioning, so the 20px gap below the button comes from VerticalOffset, not a
             top margin. -->
        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding PlacementTarget, ElementName=Root}"
               Placement="Bottom"
               VerticalOffset="20"
               AllowsTransparency="True"
               PopupAnimation="None"
               IsOpen="{Binding IsMenuOpen, ElementName=Root, Mode=OneWay}">

            <Border Background="{DynamicResource Brush.Background.Menu}"
                    Margin="20"
                    Padding="0,20"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="2"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">

                <Grid x:Name="MenuGrid">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image x:Name="Image"
                           Grid.Row="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Height="300"
                           Width="300"
                           Margin="0,0,80,20"
                           Source="/MarvinsAIRARefactored;component/Artwork/Misc/app-menu-helmet.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />

                    <Image x:Name="ColorImage"
                           Grid.Row="0"
                           HorizontalAlignment="Center"
                           Height="96"
                           Margin="20"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />

                    <ScrollViewer x:Name="MenuScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,10">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <ItemsControl ItemsSource="{Binding AppMenuItemsColumn1, ElementName=Root}"
                                          ItemTemplate="{StaticResource AppMenuItemTemplate}"
                                          VerticalAlignment="Top"
                                          MinWidth="340"
                                          Margin="10,0" />

                            <ItemsControl x:Name="Column2Items"
                                          ItemsSource="{Binding AppMenuItemsColumn2, ElementName=Root}"
                                          ItemTemplate="{StaticResource AppMenuItemTemplate}"
                                          VerticalAlignment="Top"
                                          MinWidth="340"
                                          Margin="10,0" />

                            <ItemsControl x:Name="Column3Items"
                                          ItemsSource="{Binding AppMenuItemsColumn3, ElementName=Root}"
                                          ItemTemplate="{StaticResource AppMenuItemTemplate}"
                                          VerticalAlignment="Top"
                                          MinWidth="340"
                                          Margin="10,0" />

                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Popup>

    </Grid>

</UserControl>
