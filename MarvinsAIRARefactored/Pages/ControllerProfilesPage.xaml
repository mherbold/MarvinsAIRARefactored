<UserControl x:Class="MarvinsAIRARefactored.Pages.ControllerProfilesPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization[ControllerProfiles_UC]}"
                                HelpTopic="advanced/controller-profiles/">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaComboBox x:Name="Profile_MairaComboBox"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        VerticalAlignment="Center"
                                        Label="{Binding Localization[Profile]}"
                                        SelectionChanged="Profile_MairaComboBox_SelectionChanged" />

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">

                    <controls:MairaButton x:Name="NewProfile_MairaButton"
                                          LabelOnRight="True"
                                          IsSmall="True"
                                          Label="{Binding Localization[NewProfile]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/plus-large.png"
                                          Click="NewProfile_MairaButton_Click" />

                    <controls:MairaButton x:Name="RenameProfile_MairaButton"
                                          Margin="0,10,0,0"
                                          LabelOnRight="True"
                                          IsSmall="True"
                                          Label="{Binding Localization[RenameProfile]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/rename.png"
                                          Click="RenameProfile_MairaButton_Click" />

                    <controls:MairaButton x:Name="DeleteProfile_MairaButton"
                                          Margin="0,10,0,0"
                                          LabelOnRight="True"
                                          IsSmall="True"
                                          Label="{Binding Localization[DeleteProfile]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                          Click="DeleteProfile_MairaButton_Click" />

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[ButtonMappings_UC]}"
                                HelpTopic="advanced/controller-profiles/#button-mappings">

            <StackPanel x:Name="Mappings_StackPanel" />

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
