                                    ValueString="{Binding Settings.SoundsBrakeThrottleWarningLoopStartMsString}"
                                    StepSize="10"
                                    DefaultValue="0" />

                <controls:MairaKnob Grid.Row="2" Grid.Column="4"
                                    Label="{Binding Localization[LoopEnd]}"
                                    Value="{Binding Settings.SoundsBrakeThrottleWarningLoopEndMs, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsBrakeThrottleWarningLoopEndMsString}"
                                    StepSize="10"
                                    DefaultValue="0" />

                <controls:MairaButton Grid.Row="0" Grid.Column="8" Grid.RowSpan="3"
                                      VerticalAlignment="Center"
                                      Label="{Binding Localization[Test]}"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                      Click="BrakeThrottleWarning_Test_MairaButton_Click"
                                      IsSmall="True" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[FfbClipping_UC]}"
                                HelpTopic="advanced/sounds/#ffb-clipping">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:MairaSwitch Grid.Row="0" Grid.Column="0"
                                      IsOn="{Binding Settings.SoundsFfbClippingEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}"
                                      LabelPosition="Top" />

                <controls:MairaKnob Grid.Row="0" Grid.Column="2"
                                    Label="{Binding Localization[Volume]}"
                                    Value="{Binding Settings.SoundsFfbClippingVolume, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsFfbClippingVolumeString}"
                                    StepSize="0.01"
                                    PlusButtonMappings="{Binding Settings.SoundsFfbClippingVolumePlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.SoundsFfbClippingVolumeMinusButtonMappings}"
                                    DefaultValue="0.75" />

                <controls:MairaKnob Grid.Row="2" Grid.Column="2"
                                    Label="{Binding Localization[FrequencyRatio]}"
                                    Value="{Binding Settings.SoundsFfbClippingFrequencyRatio, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsFfbClippingFrequencyRatioString}"
                                    StepSize="0.01"
                                    PlusButtonMappings="{Binding Settings.SoundsFfbClippingFrequencyRatioPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.SoundsFfbClippingFrequencyRatioMinusButtonMappings}"
                                    DefaultValue="1" />

                <controls:MairaKnob Grid.Row="0" Grid.Column="4"
                                    Label="{Binding Localization[LoopStart]}"
                                    Value="{Binding Settings.SoundsFfbClippingLoopStartMs, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsFfbClippingLoopStartMsString}"
                                    StepSize="10"
                                    DefaultValue="0" />

                <controls:MairaKnob Grid.Row="2" Grid.Column="4"
                                    Label="{Binding Localization[LoopEnd]}"
                                    Value="{Binding Settings.SoundsFfbClippingLoopEndMs, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsFfbClippingLoopEndMsString}"
                                    StepSize="10"
                                    DefaultValue="0" />

                <controls:MairaButton Grid.Row="0" Grid.Column="8" Grid.RowSpan="3"
                                      VerticalAlignment="Center"
                                      Label="{Binding Localization[Test]}"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                      Click="FfbClipping_Test_MairaButton_Click"
                                      IsSmall="True" />

            </Grid>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
