                                    PlusButtonMappings="{Binding Settings.SoundsABSEngagedFrequencyRatioPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.SoundsABSEngagedFrequencyRatioMinusButtonMappings}"
                                    DefaultValue="1" />

                <controls:MairaKnob Grid.Row="0" Grid.Column="4"
                                    Label="{Binding Localization[LoopStart]}"
                                    Value="{Binding Settings.SoundsABSEngagedLoopStartMs, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SoundsABSEngagedLoopStartMsString}"
