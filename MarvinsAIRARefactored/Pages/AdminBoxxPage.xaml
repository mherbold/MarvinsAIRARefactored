<UserControl x:Class="MarvinsAIRARefactored.Pages.AdminBoxxPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <Image Source="/MarvinsAIRARefactored;component/Artwork/Misc/adminboxx-logo.png"
               Height="72"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Connection]}"
                                HelpTopic="advanced/adminboxx/#connection">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">

                        <controls:MairaSwitch x:Name="ConnectToAdminBoxx_MairaSwitch"
                                              Label="{Binding Localization[ConnectToAdminBoxx]}"
                                              Toggled="ConnectToAdminBoxx_MairaSwitch_Toggled" />

                        <controls:MairaButton x:Name="RetryDevice_MairaButton"
                                Margin="20,0,0,0"
                                Label="{Binding Localization[Retry]}"
                                Visibility="Collapsed"
                                d:Visibility="Visible"
                                Click="RetryDevice_MairaButton_Click" />

                    </StackPanel>

                    <controls:MairaSwitch x:Name="ConnectOnStartup_MairaSwitch"
                                          Margin="0,10,0,0"
                                          Label="{Binding Localization[ConnectToAdminBoxxOnStartup]}"
                                          IsOn="{Binding Settings.AdminBoxxConnectOnStartup, Mode=TwoWay}" />

                    <controls:MairaSwitch x:Name="EnableXsrcIntegration_MairaSwitch"
                                          Margin="0,10,0,0"
                                          Label="{Binding Localization[EnableXsrcIntegration]}"
                                          IsOn="{Binding Settings.AdminBoxxEnableXsrcIntegration, Mode=TwoWay}" />

                </StackPanel>

                <controls:MairaButton x:Name="Test"
                                      Grid.Column="4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Label="{Binding Localization[Test]}"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                      Click="Test_Click"
                                      Disabled="True" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Display]}"
                                HelpTopic="advanced/adminboxx/#display">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[Brightness]}"
                                    Value="{Binding Settings.AdminBoxxBrightness, Mode=TwoWay}"
                                    ValueString="{Binding Settings.AdminBoxxBrightnessString}"
                                    ClickStepSize="0.05"
                                    DragStepSize="0.000174"
                                    PlusButtonMappings="{Binding Settings.AdminBoxxBrightnessPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.AdminBoxxBrightnessMinusButtonMappings}"
                                    ValueChangedCallback="Brightness_ValueChanged"
                                    DefaultValue="0.15" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Audio]}"
                                HelpTopic="advanced/adminboxx/#audio">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[Volume]}"
                                    Value="{Binding Settings.AdminBoxxVolume, Mode=TwoWay}"
                                    ValueString="{Binding Settings.AdminBoxxVolumeString}"
                                    ClickStepSize="0.05"
                                    DragStepSize="0.000174"
                                    PlusButtonMappings="{Binding Settings.AdminBoxxVolumePlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.AdminBoxxVolumeMinusButtonMappings}"
                                    ValueChangedCallback="Volume_ValueChanged"
                                    DefaultValue="0.75" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Links]}">

            <StackPanel Orientation="Horizontal">

                <Border BorderBrush="{DynamicResource Brush.Border.Normal}"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Padding="15,5">

                        <Hyperlink NavigateUri="https://adminboxx.com"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource Brush.Foreground.Primary}"
                                   TextDecorations="None">

                            <InlineUIContainer BaselineAlignment="Center">
                                <Rectangle Width="24" Height="24"
                                           Margin="0,0,5,0"
                                           Fill="{DynamicResource Brush.Foreground.Primary}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/MarvinsAIRARefactored;component/Artwork/Misc/world-wide-web.png"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </InlineUIContainer>

                            <Run Text="{Binding Localization[AdminBoxxWebsite], Mode=OneWay}" />

                        </Hyperlink>

                    </TextBlock>

                </Border>

                <Border BorderBrush="{DynamicResource Brush.Border.Normal}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="20,0,0,0">

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Padding="15,5">

                        <Hyperlink NavigateUri="https://discord.gg/JPrHkRYWYt"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource Brush.Foreground.Primary}"
                                   TextDecorations="None">

                            <InlineUIContainer BaselineAlignment="Center">
                                <Rectangle Width="24" Height="24"
                                           Margin="0,0,5,0"
                                           Fill="{DynamicResource Brush.Foreground.Primary}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/MarvinsAIRARefactored;component/Artwork/Misc/discord-logo.png"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </InlineUIContainer>

                            <Run Text="{Binding Localization[AdminBoxxDiscordServer], Mode=OneWay}" />

                        </Hyperlink>

                    </TextBlock>

                </Border>

                <Border BorderBrush="{DynamicResource Brush.Border.Normal}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="20,0,0,0">

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Padding="15,5">

                        <Hyperlink NavigateUri="https://info.xtremescoring.com/"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource Brush.Foreground.Primary}"
                                   TextDecorations="None">

                            <InlineUIContainer BaselineAlignment="Center">
                                <Rectangle Width="24" Height="24"
                                           Margin="0,0,5,0"
                                           Fill="{DynamicResource Brush.Foreground.Primary}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/MarvinsAIRARefactored;component/Artwork/Misc/world-wide-web.png"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </InlineUIContainer>

                            <Run Text="{Binding Localization[XtremeScoringWebsite], Mode=OneWay}" />

                        </Hyperlink>

                    </TextBlock>

                </Border>

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
