<UserControl x:Class="MarvinsAIRARefactored.Pages.OverlaysPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization[AllOverlays_UC]}">

            <controls:MairaSwitch x:Name="MakeAllOverlaysDraggable_MairaSwitch"
                                  Label="{Binding Localization[MakeAllOverlaysVisibleAndDraggable]}"
                                  Toggled="MakeAllOverlaysDraggable_MairaSwitch_Toggled" />

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GapMonitor_MairaGroupBox"
                                Label="{Binding Localization[GapMonitor_UC]}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGapMonitorWindow, Mode=TwoWay}"
                                          Label="{Binding Localization[EnableOverlayWindow]}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          IsOn="{Binding Settings.OverlaysShowGapMonitorTitle, Mode=TwoWay}"
                                          Label="{Binding Localization[ShowOverlayWindowTitle]}" />

                </StackPanel>

                <controls:MairaButton x:Name="ResetGapMonitorWindow_MairaButton"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="5"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                      Label="{Binding Localization[ResetOverlayWindow]}"
                                      Click="ResetGapMonitorWindow_MairaButton_Click" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GripOMeter_MairaGroupBox"
                                Label="{Binding Localization[GripOMeter_UC]}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGripOMeterWindow, Mode=TwoWay}"
                                          Label="{Binding Localization[EnableOverlayWindow]}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          IsOn="{Binding Settings.OverlaysShowGripOMeterTitle, Mode=TwoWay}"
                                          Label="{Binding Localization[ShowOverlayWindowTitle]}" />

                </StackPanel>

                <controls:MairaButton x:Name="ResetGripOMeterWindow_MairaButton"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="5"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                      Label="{Binding Localization[ResetOverlayWindow]}"
                                      Click="ResetGripOMeterWindow_MairaButton_Click" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="SpeechToText_MairaGroupBox"
                                Label="{Binding Localization[SpeechToText_UC]}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">

                    <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowSpeechToTextTitle, Mode=TwoWay}"
                                          Label="{Binding Localization[ShowOverlayWindowTitle]}" />

                </StackPanel>

                <controls:MairaButton x:Name="ResetSpeechToTextWindow_MairaButton"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="5"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                      Label="{Binding Localization[ResetOverlayWindow]}"
                                      Click="ResetSpeechToTextWindow_MairaButton_Click" />

            </Grid>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
