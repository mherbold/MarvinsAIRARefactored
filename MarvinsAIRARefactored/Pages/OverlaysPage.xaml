<UserControl x:Class="MarvinsAIRARefactored.Pages.OverlaysPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization[AllOverlays_UC]}">

            <StackPanel>

                <controls:MairaSwitch x:Name="MakeAllOverlaysDraggable_MairaSwitch"
                                      Label="{Binding Localization[MakeAllOverlaysVisibleAndDraggable]}"
                                      Toggled="MakeAllOverlaysDraggable_MairaSwitch_Toggled" />

                <controls:MairaSwitch x:Name="ShowWhenOffTrack_MairaSwitch"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowWhenOffTrack, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowWhenOffTrack]}" />

                <controls:MairaSwitch x:Name="ShowInReplayMode_MairaSwitch"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowInReplayMode, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowInReplayMode]}" />

                <controls:MairaButton x:Name="ResetAllOverlays_MairaButton"
                                      Margin="0,20,0,0"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                      Label="{Binding Localization[ResetAllOverlayWindows]}"
                                      Click="ResetAllOverlays_MairaButton_Click" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GapMonitor_MairaGroupBox"
                                Label="{Binding Localization[GapMonitor_UC]}">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGapMonitorWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowGapMonitorTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="DeltaMonitor_MairaGroupBox"
                                Label="{Binding Localization[DeltaMonitor_UC]}">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowDeltaMonitorWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowDeltaMonitorTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="GripOMeter_MairaGroupBox"
                                Label="{Binding Localization[GripOMeter_UC]}">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.OverlaysShowGripOMeterWindow, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowGripOMeterTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox x:Name="SpeechToText_MairaGroupBox"
                                Label="{Binding Localization[SpeechToText_UC]}">

            <StackPanel>

                <controls:MairaSwitch IsOn="{Binding Settings.SpeechToTextEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}" />

                <controls:MairaSwitch Margin="0,10,0,0"
                                      IsOn="{Binding Settings.OverlaysShowSpeechToTextTitle, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowOverlayWindowTitle]}" />

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
