<UserControl x:Class="MarvinsAIRARefactored.Pages.CommentaryPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <!-- ================================================================ -->
        <!-- ENABLED + LANGUAGE + MASTER VOLUME                               -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[Master_UC]}"
                                HelpTopic="advanced/commentary/">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaSwitch IsOn="{Binding Settings.CommentaryEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[Enabled]}"
                                      LabelPosition="Top" />

                <controls:MairaComboBox x:Name="TtsLanguage_MairaComboBox"
                                        Grid.Column="2"
                                        Label="{Binding Localization[Language]}"
                                        SelectedValue="{Binding Settings.CommentaryElevenLabsLanguage, Mode=TwoWay}" />

                <controls:MairaKnob Grid.Column="4"
                                    Label="{Binding Localization[MasterVolume]}"
                                    Value="{Binding Settings.CommentaryMasterVolume, Mode=TwoWay}"
                                    ValueString="{Binding Settings.CommentaryMasterVolumeString}"
                                    StepSize="0.01"
                                    DefaultValue="0.85" />

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- ACCOUNT                                                          -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[Account_UC]}"
                                HelpTopic="advanced/commentary/#account">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: API key + Verify button -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaTextBox Grid.Column="0"
                                           x:Name="ApiKey_MairaTextBox"
                                           Label="{Binding Localization[ApiKey]}"
                                           IsPassword="True"
                                           ValueChanged="ApiKey_MairaTextBox_ValueChanged"
                                           FontSize="20" />

                    <controls:MairaButton Grid.Column="2"
                                          x:Name="VerifyKey_MairaButton"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/power-blue.png"
                                          Label="{Binding Localization[VerifyKey]}"
                                          Click="VerifyKey_MairaButton_Click"
                                          IsSmall="True"
                                          VerticalAlignment="Bottom" />

                </Grid>

                <!-- Row 1: API key status -->

                <TextBlock x:Name="VerifyResult_TextBlock"
                           Grid.Row="2"
                           Style="{DynamicResource MairaTextBlockStyle}"
                           Foreground="#ff5b2e"
                           Margin="0,5,0,0"
                           d:Text="Just a test" />

                <!-- Row 2: Model -->
                <controls:MairaComboBox x:Name="Model_MairaComboBox"
                                        Grid.Row="4"
                                        Label="{Binding Localization[Model]}"
                                        SelectedValue="{Binding Settings.CommentaryElevenLabsModelId, Mode=TwoWay}" />

                <!-- Row 4: Subscription usage -->
                <controls:MairaProgressBar x:Name="SubscriptionUsage_MairaProgressBar"
                                            Grid.Row="6"
                                            Label="{Binding Localization[Usage]}"/>

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- VOICE ROSTER — slot 0: Crew Chief                               -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[VoiceRoster_UC]}"
                                HelpTopic="advanced/commentary/#voices">

            <StackPanel>

                <!-- Slot 0 — Crew Chief -->
                <controls:MairaExpander x:Name="Slot0_Expander"
                                        Label="{Binding Settings.CommentaryVoiceSlots[0].RoleLabel}"
                                        Margin="0,0,0,20"
                                        Visibility="Collapsed">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:MairaComboBox Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Label="{Binding Localization[Voice]}"
                                                SelectedValue="{Binding Settings.CommentaryVoiceSlots[0].VoiceId, Mode=TwoWay}" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="0"
                                            Label="{Binding Localization[Consistency]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[0].Stability, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[0].StabilityString}"
                                            StepSize="0.05"
                                            DefaultValue="0.75" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="2"
                                            Label="{Binding Localization[Dramatic]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[0].Style, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[0].StyleString}"
                                            StepSize="0.05"
                                            DefaultValue="0.30" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="4"
                                            Label="{Binding Localization[SimilarityBoost]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[0].SimilarityBoost, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[0].SimilarityBoostString}"
                                            StepSize="0.05"
                                            DefaultValue="0.80" />

                        <controls:MairaKnob Grid.Row="4"
                                            Grid.Column="0"
                                            Label="{Binding Localization[SlotVolume]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[0].Volume, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[0].VolumeString}"
                                            StepSize="0.05"
                                            DefaultValue="1.0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[0].Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding Settings.CommentaryVoiceSlots[0].HasVoiceSelected}"
                                                  Label="{Binding Localization[Enabled]}"
                                                  Margin="0,0,0,10" />

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[0].SpeakerBoost, Mode=TwoWay}"
                                                  Label="{Binding Localization[SpeakerBoost]}" />

                        </StackPanel>

                        <controls:MairaButton Grid.Row="4"
                                              Grid.Column="4"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                              Label="{Binding Localization[TestVoice]}"
                                              Click="Slot0Test_MairaButton_Click"
                                              IsSmall="True">
                            <controls:MairaButton.Disabled>
                                <MultiBinding Converter="{StaticResource BoolAllTrueNegationConverter}">
                                    <Binding Path="Settings.CommentaryEnabled" />
                                    <Binding Path="Settings.CommentaryVoiceSlots[0].Enabled" />
                                </MultiBinding>
                            </controls:MairaButton.Disabled>
                        </controls:MairaButton>

                    </Grid>

                </controls:MairaExpander>

                <!-- Slot 1 — Spotter -->
                <controls:MairaExpander x:Name="Slot1_Expander"
                                        Label="{Binding Settings.CommentaryVoiceSlots[1].RoleLabel}"
                                        Margin="0,0,0,20">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:MairaComboBox Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Label="{Binding Localization[Voice]}"
                                                SelectedValue="{Binding Settings.CommentaryVoiceSlots[1].VoiceId, Mode=TwoWay}" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="0"
                                            Label="{Binding Localization[Consistency]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[1].Stability, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[1].StabilityString}"
                                            StepSize="0.05"
                                            DefaultValue="0.90" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="2"
                                            Label="{Binding Localization[Dramatic]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[1].Style, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[1].StyleString}"
                                            StepSize="0.05"
                                            DefaultValue="0.15" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="4"
                                            Label="{Binding Localization[SimilarityBoost]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[1].SimilarityBoost, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[1].SimilarityBoostString}"
                                            StepSize="0.05"
                                            DefaultValue="0.75" />

                        <controls:MairaKnob Grid.Row="4"
                                            Grid.Column="0"
                                            Label="{Binding Localization[SlotVolume]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[1].Volume, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[1].VolumeString}"
                                            StepSize="0.05"
                                            DefaultValue="1.0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[1].Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding Settings.CommentaryVoiceSlots[1].HasVoiceSelected}"
                                                  Label="{Binding Localization[Enabled]}"
                                                  Margin="0,0,0,10" />

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[1].SpeakerBoost, Mode=TwoWay}"
                                                  Label="{Binding Localization[SpeakerBoost]}" />

                        </StackPanel>

                        <controls:MairaButton Grid.Row="4"
                                              Grid.Column="4"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                              Label="{Binding Localization[TestVoice]}"
                                              Click="Slot1Test_MairaButton_Click"
                                              IsSmall="True">
                            <controls:MairaButton.Disabled>
                                <MultiBinding Converter="{StaticResource BoolAllTrueNegationConverter}">
                                    <Binding Path="Settings.CommentaryEnabled" />
                                    <Binding Path="Settings.CommentaryVoiceSlots[1].Enabled" />
                                </MultiBinding>
                            </controls:MairaButton.Disabled>
                        </controls:MairaButton>

                    </Grid>
                </controls:MairaExpander>

                <!-- Slot 2 — Sportscaster 1 (Lead) -->
                <controls:MairaExpander x:Name="Slot2_Expander"
                                        Label="{Binding Settings.CommentaryVoiceSlots[2].RoleLabel}"
                                        Margin="0,0,0,20"
                                        Visibility="Collapsed">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:MairaComboBox Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Label="{Binding Localization[Voice]}"
                                                SelectedValue="{Binding Settings.CommentaryVoiceSlots[2].VoiceId, Mode=TwoWay}" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="0"
                                            Label="{Binding Localization[Consistency]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[2].Stability, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[2].StabilityString}"
                                            StepSize="0.05"
                                            DefaultValue="0.35" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="2"
                                            Label="{Binding Localization[Dramatic]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[2].Style, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[2].StyleString}"
                                            StepSize="0.05"
                                            DefaultValue="0.75" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="4"
                                            Label="{Binding Localization[SimilarityBoost]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[2].SimilarityBoost, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[2].SimilarityBoostString}"
                                            StepSize="0.05"
                                            DefaultValue="0.75" />

                        <controls:MairaKnob Grid.Row="4"
                                            Grid.Column="0"
                                            Label="{Binding Localization[SlotVolume]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[2].Volume, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[2].VolumeString}"
                                            StepSize="0.05"
                                            DefaultValue="1.0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[2].Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding Settings.CommentaryVoiceSlots[2].HasVoiceSelected}"
                                                  Label="{Binding Localization[Enabled]}"
                                                  Margin="0,0,0,10" />

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[2].SpeakerBoost, Mode=TwoWay}"
                                                  Label="{Binding Localization[SpeakerBoost]}" />

                        </StackPanel>

                        <controls:MairaButton Grid.Row="4"
                                              Grid.Column="4"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                              Label="{Binding Localization[TestVoice]}"
                                              Click="Slot2Test_MairaButton_Click"
                                              IsSmall="True">
                            <controls:MairaButton.Disabled>
                                <MultiBinding Converter="{StaticResource BoolAllTrueNegationConverter}">
                                    <Binding Path="Settings.CommentaryEnabled" />
                                    <Binding Path="Settings.CommentaryVoiceSlots[2].Enabled" />
                                </MultiBinding>
                            </controls:MairaButton.Disabled>
                        </controls:MairaButton>

                    </Grid>
                </controls:MairaExpander>

                <!-- Slot 3 — Sportscaster 2 (Color) -->
                <controls:MairaExpander x:Name="Slot3_Expander"
                                        Label="{Binding Settings.CommentaryVoiceSlots[3].RoleLabel}"
                                        Margin="0,0,0,20"
                                        Visibility="Collapsed">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:MairaComboBox Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Label="{Binding Localization[Voice]}"
                                                SelectedValue="{Binding Settings.CommentaryVoiceSlots[3].VoiceId, Mode=TwoWay}" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="0"
                                            Label="{Binding Localization[Consistency]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[3].Stability, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[3].StabilityString}"
                                            StepSize="0.05"
                                            DefaultValue="0.55" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="2"
                                            Label="{Binding Localization[Dramatic]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[3].Style, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[3].StyleString}"
                                            StepSize="0.05"
                                            DefaultValue="0.50" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="4"
                                            Label="{Binding Localization[SimilarityBoost]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[3].SimilarityBoost, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[3].SimilarityBoostString}"
                                            StepSize="0.05"
                                            DefaultValue="0.75" />

                        <controls:MairaKnob Grid.Row="4"
                                            Grid.Column="0"
                                            Label="{Binding Localization[SlotVolume]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[3].Volume, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[3].VolumeString}"
                                            StepSize="0.05"
                                            DefaultValue="1.0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[3].Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding Settings.CommentaryVoiceSlots[3].HasVoiceSelected}"
                                                  Label="{Binding Localization[Enabled]}"
                                                  Margin="0,0,0,10" />

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[3].SpeakerBoost, Mode=TwoWay}"
                                                  Label="{Binding Localization[SpeakerBoost]}" />

                        </StackPanel>

                        <controls:MairaButton Grid.Row="4"
                                              Grid.Column="4"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                              Label="{Binding Localization[TestVoice]}"
                                              Click="Slot3Test_MairaButton_Click"
                                              IsSmall="True">
                            <controls:MairaButton.Disabled>
                                <MultiBinding Converter="{StaticResource BoolAllTrueNegationConverter}">
                                    <Binding Path="Settings.CommentaryEnabled" />
                                    <Binding Path="Settings.CommentaryVoiceSlots[3].Enabled" />
                                </MultiBinding>
                            </controls:MairaButton.Disabled>
                        </controls:MairaButton>

                    </Grid>
                </controls:MairaExpander>

                <!-- Slot 4 — Pit Reporter -->
                <controls:MairaExpander x:Name="Slot4_Expander"
                                        Label="{Binding Settings.CommentaryVoiceSlots[4].RoleLabel}"
                                        Visibility="Collapsed">
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:MairaComboBox Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="5"
                                                Label="{Binding Localization[Voice]}"
                                                SelectedValue="{Binding Settings.CommentaryVoiceSlots[4].VoiceId, Mode=TwoWay}" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="0"
                                            Label="{Binding Localization[Consistency]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[4].Stability, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[4].StabilityString}"
                                            StepSize="0.05"
                                            DefaultValue="0.45" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="2"
                                            Label="{Binding Localization[Dramatic]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[4].Style, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[4].StyleString}"
                                            StepSize="0.05"
                                            DefaultValue="0.65" />

                        <controls:MairaKnob Grid.Row="2"
                                            Grid.Column="4"
                                            Label="{Binding Localization[SimilarityBoost]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[4].SimilarityBoost, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[4].SimilarityBoostString}"
                                            StepSize="0.05"
                                            DefaultValue="0.80" />

                        <controls:MairaKnob Grid.Row="4"
                                            Grid.Column="0"
                                            Label="{Binding Localization[SlotVolume]}"
                                            Value="{Binding Settings.CommentaryVoiceSlots[4].Volume, Mode=TwoWay}"
                                            ValueString="{Binding Settings.CommentaryVoiceSlots[4].VolumeString}"
                                            StepSize="0.05"
                                            DefaultValue="1.0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="2">

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[4].Enabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding Settings.CommentaryVoiceSlots[4].HasVoiceSelected}"
                                                  Label="{Binding Localization[Enabled]}"
                                                  Margin="0,0,0,10" />

                            <controls:MairaSwitch IsOn="{Binding Settings.CommentaryVoiceSlots[4].SpeakerBoost, Mode=TwoWay}"
                                                  Label="{Binding Localization[SpeakerBoost]}" />

                        </StackPanel>

                        <controls:MairaButton Grid.Row="4"
                                              Grid.Column="4"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                              Label="{Binding Localization[TestVoice]}"
                                              Click="Slot4Test_MairaButton_Click"
                                              IsSmall="True">
                            <controls:MairaButton.Disabled>
                                <MultiBinding Converter="{StaticResource BoolAllTrueNegationConverter}">
                                    <Binding Path="Settings.CommentaryEnabled" />
                                    <Binding Path="Settings.CommentaryVoiceSlots[4].Enabled" />
                                </MultiBinding>
                            </controls:MairaButton.Disabled>
                        </controls:MairaButton>

                    </Grid>
                </controls:MairaExpander>

            </StackPanel>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- CREW CHIEF COMMENTARY                                           -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[CrewChiefCommentary_UC]}"
                                HelpTopic="advanced/commentary/#crew-chief"
                                Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- SPOTTER COMMENTARY                                               -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[SpotterCommentary_UC]}"
                                HelpTopic="advanced/commentary/#spotter">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <!-- proximity calls -->
                    <controls:MairaSwitch IsOn="{Binding Settings.CommentarySpotterCarProximity, Mode=TwoWay}"
                                          Label="{Binding Localization[CarProximity]}" />

                    <!-- flag calls -->
                    <controls:MairaSwitch Margin="0,10,0,0"
                                          IsOn="{Binding Settings.CommentarySpotterFlagCalls, Mode=TwoWay}"
                                          Label="{Binding Localization[FlagCalls]}" />

                </StackPanel>

                <!-- reminder interval -->
                <controls:MairaKnob Grid.Column="2"
                                    Label="{Binding Localization[CarProximityReminderInterval]}"
                                    Value="{Binding Settings.CommentarySpotterCarProximityReminderInterval, Mode=TwoWay}"
                                    ValueString="{Binding Settings.CommentarySpotterCarProximityReminderIntervalString}"
                                    StepSize="0.1"
                                    DefaultValue="3.0" />

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- SPORTSCASTER 1 COMMENTARY                                        -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[Sportscaster1Commentary_UC]}"
                                HelpTopic="advanced/commentary/#sportscaster-1"
                                Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- SPORTSCASTER 2 COMMENTARY                                        -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[Sportscaster2Commentary_UC]}"
                                HelpTopic="advanced/commentary/#sportscaster-2"
                                Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- PIT REPORTER COMMENTARY                                          -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox Label="{Binding Localization[PitReporterCommentary_UC]}"
                                HelpTopic="advanced/commentary/#pit-reporter"
                                Visibility="Collapsed">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            </Grid>

        </controls:MairaGroupBox>

        <!-- ================================================================ -->
        <!-- COMMENTARY PHRASES                                               -->
        <!-- ================================================================ -->

        <controls:MairaGroupBox x:Name="CommentaryPhrases_MairaGroupBox"
                                Label="{Binding Localization[CommentaryPhrases_UC]}"
                                HelpTopic="advanced/commentary/#phrases">

            <StackPanel>

                <!-- Description + Reset All button -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Localization[EditCommentaryPhrasesDescription]}"
                               Style="{DynamicResource MairaTextBlockStyle}"
                               TextWrapping="Wrap" />

                    <controls:MairaButton Grid.Column="2"
                                          x:Name="ResetAllPhrases_MairaButton"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                          Label="{Binding Localization[ResetAllPhrases]}"
                                          Click="ResetAllPhrases_MairaButton_Click"
                                          IsSmall="True"
                                          VerticalAlignment="Top"
                                          Visibility="Collapsed" />
                </Grid>

                <!-- Status text -->
                <TextBlock x:Name="PhraseEditorStatus_TextBlock"
                           Style="{DynamicResource MairaTextBlockStyle}"
                           Margin="0,0,0,6" />

                <!-- Search box -->
                <controls:MairaTextBox x:Name="PhraseSearch_MairaTextBox"
                                       FontSize="20"
                                       Placeholder="{Binding Localization[PhraseSearch]}"
                                       Margin="0,0,0,8"
                                       ValueChanged="PhraseSearch_MairaTextBox_ValueChanged" />

                <!-- Scrollable event-key list -->
                <Border BorderThickness="1"
                        BorderBrush="#30ffffff"
                        CornerRadius="4">
                    <ScrollViewer MaxHeight="500"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="4">

                        <ItemsControl x:Name="PhraseEventKeys_ItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- DataContext is PhraseEventKeyViewModel -->
                                    <controls:MairaExpander Label="{Binding EventKey}"
                                                            Margin="0,0,0,6">
                                        <StackPanel Margin="0,6,0,0">

                                            <!-- Existing phrases list -->
                                            <ItemsControl ItemsSource="{Binding Phrases}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- DataContext is PhraseEntryViewModel -->
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <controls:MairaTextBox Grid.Column="0"
                                                                                   Value="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                   Tag="{Binding}"
                                                                                   LostFocus="PhraseTextBox_LostFocus" />

                                                            <controls:MairaButton Grid.Column="2"
                                                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                                                                  IsSmall="True"
                                                                                  Tag="{Binding}"
                                                                                  Click="TestPhrase_MairaButton_Click"
                                                                                  VerticalAlignment="Bottom" />

                                                            <controls:MairaButton Grid.Column="4"
                                                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/minus.png"
                                                                                  IsSmall="True"
                                                                                  Tag="{Binding}"
                                                                                  Click="RemovePhrase_MairaButton_Click"
                                                                                  VerticalAlignment="Bottom" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Add phrase + Reset buttons -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <controls:MairaButton Grid.Column="0"
                                                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/plus.png"
                                                                      Label="{Binding DataContext.Localization[AddPhrase], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      IsSmall="True"
                                                                      Tag="{Binding}"
                                                                      Click="AddPhrase_MairaButton_Click" />

                                                <controls:MairaButton Grid.Column="2"
                                                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                                                      Label="{Binding DataContext.Localization[ResetEventPhrases], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      IsSmall="True"
                                                                      Tag="{Binding}"
                                                                      Click="ResetEventPhrases_MairaButton_Click" />
                                            </Grid>

                                        </StackPanel>
                                    </controls:MairaExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>
                </Border>

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>

