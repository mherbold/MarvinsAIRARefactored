<UserControl x:Class="MarvinsAIRARefactored.Pages.AccessibilityPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[SteeringOutput]}"
                                HelpTopic="advanced/accessibility/#steering-output">

            <StackPanel>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[AccessibilityDescription]}"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,20,0,0">

                    <controls:MairaSwitch Label="{Binding Localization[SendSteeringToVJoy]}"
                                          IsOn="{Binding Settings.GameBridgeSendSteeringToVJoy, Mode=TwoWay}" />

                    <TextBlock x:Name="VJoyStatus_TextBlock"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center" />

                </StackPanel>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[AccessibilitySendSteeringDescription]}"
                           Foreground="#979797"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[WheelbaseRotationRange]}"
                                        Value="{Binding Settings.AccessibilityWheelbaseRange, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityWheelbaseRangeString}"
                                        ClickStepSize="10"
                                        DragStepSize="0.469"
                                        PlusButtonMappings="{Binding Settings.AccessibilityWheelbaseRangePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityWheelbaseRangeMinusButtonMappings}"
                                        DefaultValue="900" />

                    <TextBlock Grid.Column="2"
                               Grid.ColumnSpan="3"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[WheelbaseRotationRangeDescription]}"
                               Foreground="#979797"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Calibration]}"
                                HelpTopic="advanced/accessibility/#calibration">

            <StackPanel>

                <controls:MairaSwitch Label="{Binding Localization[CalibrationMode]}"
                                      IsOn="{Binding Settings.GameBridgeSteeringTestEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding Settings.GameBridgeSendSteeringToVJoy}" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[AccessibilityCalibrationDescription]}"
                           Foreground="#979797"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <StackPanel>

                    <StackPanel.Resources>
                        <Style TargetType="controls:MairaButton">
                            <Setter Property="Margin"
                                    Value="0,20,0,0" />
                            <Setter Property="Disabled"
                                    Value="{Binding Settings.GameBridgeSteeringTestEnabled, Converter={StaticResource BoolNegationConverter}}" />
                        </Style>
                    </StackPanel.Resources>

                    <UniformGrid Columns="3">

                        <controls:MairaButton Label="{Binding Localization[SteeringWheelLeft]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-left.png"
                                              Click="SteeringWheelLeft_MairaButton_Click" />

                        <controls:MairaButton Label="{Binding Localization[SteeringWheelCenter]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-center.png"
                                              Click="SteeringWheelCenter_MairaButton_Click" />

                        <controls:MairaButton Label="{Binding Localization[SteeringWheelRight]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-right.png"
                                              Click="SteeringWheelRight_MairaButton_Click" />

                    </UniformGrid>

                    <UniformGrid Columns="3">

                        <controls:MairaButton Label="{Binding Localization[SteeringWheel90Left]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-90-left.png"
                                              Click="SteeringWheel90Left_MairaButton_Click" />

                        <controls:MairaButton x:Name="SteeringWheelSweep_MairaButton"
                                              Label="{Binding Localization[SteeringWheelSweep]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-sweep.png"
                                              BlinkIcon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-sweep-orange.png"
                                              Click="SteeringWheelSweep_MairaButton_Click" />

                        <controls:MairaButton Label="{Binding Localization[SteeringWheel90Right]}"
                                              Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/steering-wheel-90-right.png"
                                              Click="SteeringWheel90Right_MairaButton_Click" />

                    </UniformGrid>

                </StackPanel>

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[SteeringRemap]}"
                                HelpTopic="advanced/accessibility/#steering-remap">

            <StackPanel>

                <controls:MairaMappableSwitch IsOn="{Binding Settings.AccessibilityRemapEnabled, Mode=TwoWay}"
                                              ButtonMappings="{Binding Settings.AccessibilityRemapEnabledButtonMappings}"
                                              Label="{Binding Localization[Enabled]}" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[AccessibilityRemapDescription]}"
                           Foreground="#979797"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <!-- live curve: physical wheel angle across (turned left = left side), steering as a fraction of
                     the car's lock up (full right at the top, full left at the bottom) - everything is drawn in
                     code on SizeChanged / setting changes, the dot and readout move with the wheel -->
                <Border Height="280"
                        Margin="0,20,0,0"
                        CornerRadius="5"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource Brush.Border.Normal}"
                        Background="{DynamicResource Brush.Background.Popup}">

                    <Canvas x:Name="Curve_Canvas"
                            ClipToBounds="True"
                            SizeChanged="Curve_Canvas_SizeChanged">

                        <Path x:Name="Axes_Path"
                              Stroke="{DynamicResource Brush.Foreground.Muted}"
                              StrokeThickness="1"
                              Opacity="0.5" />

                        <Path x:Name="Limits_Path"
                              Stroke="{DynamicResource Brush.Foreground.Muted}"
                              StrokeThickness="1"
                              StrokeDashArray="4,4"
                              Opacity="0.6" />

                        <Path x:Name="SpeedCurve_Path"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="2"
                              StrokeDashArray="3,3"
                              Opacity="0.6"
                              StrokeLineJoin="Round" />

                        <Path x:Name="Curve_Path"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="3"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />

                        <TextBlock x:Name="LeftLabel_TextBlock"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Foreground.Muted}"
                                   FontSize="12" />

                        <TextBlock x:Name="RightLabel_TextBlock"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Foreground.Muted}"
                                   FontSize="12" />

                        <TextBlock x:Name="FullLeftLabel_TextBlock"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Foreground.Muted}"
                                   FontSize="12" />

                        <TextBlock x:Name="FullRightLabel_TextBlock"
                                   Style="{StaticResource MairaTextBlockStyle}"
                                   Foreground="{DynamicResource Brush.Foreground.Muted}"
                                   FontSize="12" />

                        <Ellipse x:Name="Dot_Ellipse"
                                 Width="14"
                                 Height="14"
                                 Fill="{DynamicResource Brush.Accent}"
                                 Stroke="{DynamicResource Brush.Background.Popup}"
                                 StrokeThickness="2" />

                    </Canvas>

                </Border>

                <TextBlock x:Name="LiveReadout_TextBlock"
                           Style="{StaticResource MairaTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[CenterOffset]}"
                                        Value="{Binding Settings.AccessibilityCenterOffset, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityCenterOffsetString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.03125"
                                        PlusButtonMappings="{Binding Settings.AccessibilityCenterOffsetPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityCenterOffsetMinusButtonMappings}"
                                        DefaultValue="0" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[CenterDeadzone]}"
                                        Value="{Binding Settings.AccessibilityCenterDeadzone, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityCenterDeadzoneString}"
                                        ClickStepSize="0.5"
                                        DragStepSize="0.00347"
                                        PlusButtonMappings="{Binding Settings.AccessibilityCenterDeadzonePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityCenterDeadzoneMinusButtonMappings}"
                                        DefaultValue="0" />

                    <controls:MairaKnob Grid.Column="4"
                                        Label="{Binding Localization[TremorSmoothing]}"
                                        Value="{Binding Settings.AccessibilityTremorSmoothing, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityTremorSmoothingString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000174"
                                        PlusButtonMappings="{Binding Settings.AccessibilityTremorSmoothingPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityTremorSmoothingMinusButtonMappings}"
                                        DefaultValue="0" />

                </Grid>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[LeftRange]}"
                                        Value="{Binding Settings.AccessibilityLeftRange, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityLeftRangeString}"
                                        ClickStepSize="5"
                                        DragStepSize="0.1233"
                                        PlusButtonMappings="{Binding Settings.AccessibilityLeftRangePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityLeftRangeMinusButtonMappings}"
                                        DefaultValue="180" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[LeftCurve]}"
                                        Value="{Binding Settings.AccessibilityLeftCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityLeftCurveString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000347"
                                        PlusButtonMappings="{Binding Settings.AccessibilityLeftCurvePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityLeftCurveMinusButtonMappings}"
                                        ShowCurve="True"
                                        DefaultValue="0" />

                </Grid>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[RightRange]}"
                                        Value="{Binding Settings.AccessibilityRightRange, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityRightRangeString}"
                                        ClickStepSize="5"
                                        DragStepSize="0.1233"
                                        PlusButtonMappings="{Binding Settings.AccessibilityRightRangePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityRightRangeMinusButtonMappings}"
                                        DefaultValue="180" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[RightCurve]}"
                                        Value="{Binding Settings.AccessibilityRightCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityRightCurveString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000347"
                                        PlusButtonMappings="{Binding Settings.AccessibilityRightCurvePlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityRightCurveMinusButtonMappings}"
                                        ShowCurve="True"
                                        DefaultValue="0" />

                </Grid>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[HighSpeedSensitivity]}"
                                        Value="{Binding Settings.AccessibilityHighSpeedSensitivity, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityHighSpeedSensitivityString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000156"
                                        PlusButtonMappings="{Binding Settings.AccessibilityHighSpeedSensitivityPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityHighSpeedSensitivityMinusButtonMappings}"
                                        DefaultValue="1" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[FullEffectSpeed]}"
                                        Value="{Binding Settings.AccessibilityFullEffectSpeed, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityFullEffectSpeedString}"
                                        ClickStepSize="0.5"
                                        DragStepSize="0.0156"
                                        PlusButtonMappings="{Binding Settings.AccessibilityFullEffectSpeedPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityFullEffectSpeedMinusButtonMappings}"
                                        DefaultValue="55.5556" />

                    <TextBlock Grid.Column="4"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[SpeedSensitiveSteeringDescription]}"
                               Foreground="#979797"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[ForceFeedback]}"
                                HelpTopic="advanced/accessibility/#force-feedback">

            <StackPanel>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[AccessibilityForceFeedbackDescription]}"
                           Foreground="#979797"
                           TextWrapping="Wrap" />

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[LeftTurnStrength]}"
                                        Value="{Binding Settings.AccessibilityLeftFFBStrength, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityLeftFFBStrengthString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000347"
                                        PlusButtonMappings="{Binding Settings.AccessibilityLeftFFBStrengthPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityLeftFFBStrengthMinusButtonMappings}"
                                        DefaultValue="1" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[RightTurnStrength]}"
                                        Value="{Binding Settings.AccessibilityRightFFBStrength, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityRightFFBStrengthString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000347"
                                        PlusButtonMappings="{Binding Settings.AccessibilityRightFFBStrengthPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityRightFFBStrengthMinusButtonMappings}"
                                        DefaultValue="1" />

                    <controls:MairaKnob Grid.Column="4"
                                        Label="{Binding Localization[CenteringHelp]}"
                                        Value="{Binding Settings.AccessibilityCenteringHelp, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AccessibilityCenteringHelpString}"
                                        ClickStepSize="0.05"
                                        DragStepSize="0.000174"
                                        PlusButtonMappings="{Binding Settings.AccessibilityCenteringHelpPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.AccessibilityCenteringHelpMinusButtonMappings}"
                                        DefaultValue="0" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
