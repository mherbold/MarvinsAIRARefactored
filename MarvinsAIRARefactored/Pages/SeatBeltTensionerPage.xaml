<UserControl x:Class="MarvinsAIRARefactored.Pages.SeatBeltTensionerPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Connection]}"
                                HelpTopic="advanced/seat-belt-tensioner/#connection">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <controls:MairaSwitch x:Name="ConnectToSbt_MairaSwitch"
                                          Label="{Binding Localization[ConnectToSBT]}"
                                          Toggled="ConnectToSbt_MairaSwitch_Toggled" />

                    <controls:MairaButton x:Name="RetryDevice_MairaButton"
                                          Margin="20,0,0,0"
                                          Label="{Binding Localization[Retry]}"
                                          Visibility="Collapsed"
                                          d:Visibility="Visible"
                                          Click="RetryDevice_MairaButton_Click" />

                </StackPanel>

                <controls:MairaSwitch x:Name="ConnectOnStartup_MairaSwitch"
                                      Margin="0,10,0,0"
                                      Label="{Binding Localization[ConnectToSBTOnStartup]}"
                                      IsOn="{Binding Settings.SeatBeltTensionerConnectOnStartup, Mode=TwoWay}" />
            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Calibration]}"
                                HelpTopic="advanced/seat-belt-tensioner/#calibration">

            <StackPanel>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[MinimumAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerMinimum, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMinimumString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0156"
                                        DefaultValue="60" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[NeutralAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerNeutral, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerNeutralString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0104"
                                        DefaultValue="90" />

                    <controls:MairaKnob Grid.Column="4"
                                        Label="{Binding Localization[MaximumAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerMaximum, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMaximumString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0156"
                                        DefaultValue="120" />

                </Grid>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[MaxMotorSpeed]}"
                                        Value="{Binding Settings.SeatBeltTensionerMaxMotorSpeed, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMaxMotorSpeedString}"
                                        ClickStepSize="5"
                                        DragStepSize="0.0408"
                                        DefaultValue="180" />

                    <controls:MairaSwitch Grid.Column="2"
                                          Label="{Binding Localization[InvertedArms]}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsOn="{Binding Settings.SeatBeltTensionerInvertedArms, Mode=TwoWay}" />

                    <controls:MairaButton x:Name="CalibrationSweepTest_MairaButton"
                                          Grid.Column="4"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="CalibrationSweepTest_MairaButton_Click" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Surge]}"
                                HelpTopic="advanced/seat-belt-tensioner/#surge">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <controls:MairaComboBox x:Name="SurgeMode_MairaComboBox"
                                            Label="{Binding Localization[AxisMode]}"
                                            ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeModeContextSwitches}"
                                            SelectionChanged="SurgeMode_MairaComboBox_SelectionChanged"
                                            SelectedValue="{Binding Settings.SeatBeltTensionerSurgeMode, Mode=TwoWay}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSurgeSubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeSubtractGravityContextSwitches}" />

                    <controls:MairaButton x:Name="SurgeTest_MairaButton"
                                          Margin="0,50,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="SurgeTest_MairaButton_Click" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <controls:MairaKnob Label="{Binding Localization[MaxGForce]}"
                                        Value="{Binding Settings.SeatBeltTensionerSurgeMaxG, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSurgeMaxGString}"
                                        ClickStepSize="0.1"
                                        DragStepSize="0.00866"
                                        DefaultValue="4"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeMaxGContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[DeadZone]}"
                                        Value="{Binding Settings.SeatBeltTensionerSurgeDeadZone, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSurgeDeadZoneString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000172"
                                        DefaultValue="0"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeDeadZoneContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Smoothing]}"
                                        Value="{Binding Settings.SeatBeltTensionerSurgeSmoothing, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSurgeSmoothingString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000174"
                                        DefaultValue="0"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeSmoothingContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Curve]}"
                                        Value="{Binding Settings.SeatBeltTensionerSurgeCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSurgeCurveString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000347"
                                        DefaultValue="0"
                                        ShowCurve="True"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeCurveContextSwitches}" />

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Border.Normal}"
                            Background="{DynamicResource Brush.Background.Popup}"
                            CornerRadius="5">

                        <Image x:Name="SurgeGraph_Image"
                               Width="1200"
                               Height="251"
                               HorizontalAlignment="Right"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                    </Border>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MinG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding SurgeMinGString, ElementName=Root}" />

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MaxG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding SurgeMaxGString, ElementName=Root}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Sway]}"
                                HelpTopic="advanced/seat-belt-tensioner/#sway">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <controls:MairaComboBox x:Name="SwayMode_MairaComboBox"
                                            Label="{Binding Localization[AxisMode]}"
                                            ContextSwitches="{Binding Settings.SeatBeltTensionerSwayModeContextSwitches}"
                                            SelectionChanged="SwayMode_MairaComboBox_SelectionChanged"
                                            SelectedValue="{Binding Settings.SeatBeltTensionerSwayMode, Mode=TwoWay}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSwaySubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSwaySubtractGravityContextSwitches}" />

                    <controls:MairaButton x:Name="SwayTest_MairaButton"
                                          Margin="0,50,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="SwayTest_MairaButton_Click" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <controls:MairaKnob Label="{Binding Localization[MaxGForce]}"
                                        Value="{Binding Settings.SeatBeltTensionerSwayMaxG, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSwayMaxGString}"
                                        ClickStepSize="0.1"
                                        DragStepSize="0.00866"
                                        DefaultValue="2"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSwayMaxGContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[DeadZone]}"
                                        Value="{Binding Settings.SeatBeltTensionerSwayDeadZone, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSwayDeadZoneString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000172"
                                        DefaultValue="0.05"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSwayDeadZoneContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Smoothing]}"
                                        Value="{Binding Settings.SeatBeltTensionerSwaySmoothing, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSwaySmoothingString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000174"
                                        DefaultValue="0"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSwaySmoothingContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Curve]}"
                                        Value="{Binding Settings.SeatBeltTensionerSwayCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSwayCurveString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000347"
                                        DefaultValue="0.15"
                                        ShowCurve="True"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSwayCurveContextSwitches}" />

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Border.Normal}"
                            Background="{DynamicResource Brush.Background.Popup}"
                            CornerRadius="5">

                        <Image x:Name="SwayGraph_Image"
                               Width="1200"
                               Height="251"
                               HorizontalAlignment="Right"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                    </Border>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MinG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding SwayMinGString, ElementName=Root}" />

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MaxG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding SwayMaxGString, ElementName=Root}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Heave]}"
                                HelpTopic="advanced/seat-belt-tensioner/#heave">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <controls:MairaComboBox x:Name="HeaveMode_MairaComboBox"
                                            Label="{Binding Localization[AxisMode]}"
                                            ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveModeContextSwitches}"
                                            SelectionChanged="HeaveMode_MairaComboBox_SelectionChanged"
                                            SelectedValue="{Binding Settings.SeatBeltTensionerHeaveMode, Mode=TwoWay}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerHeaveSubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveSubtractGravityContextSwitches}" />

                    <controls:MairaButton x:Name="HeaveTest_MairaButton"
                                          Margin="0,50,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="HeaveTest_MairaButton_Click" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <controls:MairaKnob Label="{Binding Localization[MaxGForce]}"
                                        Value="{Binding Settings.SeatBeltTensionerHeaveMaxG, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerHeaveMaxGString}"
                                        ClickStepSize="0.1"
                                        DragStepSize="0.00866"
                                        DefaultValue="1.5"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveMaxGContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[DeadZone]}"
                                        Value="{Binding Settings.SeatBeltTensionerHeaveDeadZone, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerHeaveDeadZoneString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000172"
                                        DefaultValue="0.05"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveDeadZoneContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Smoothing]}"
                                        Value="{Binding Settings.SeatBeltTensionerHeaveSmoothing, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerHeaveSmoothingString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000174"
                                        DefaultValue="0.1"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveSmoothingContextSwitches}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Curve]}"
                                        Value="{Binding Settings.SeatBeltTensionerHeaveCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerHeaveCurveString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000347"
                                        DefaultValue="0.15"
                                        ShowCurve="True"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveCurveContextSwitches}" />

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Border.Normal}"
                            Background="{DynamicResource Brush.Background.Popup}"
                            CornerRadius="5">

                        <Image x:Name="HeaveGraph_Image"
                               Width="1200"
                               Height="251"
                               HorizontalAlignment="Right"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                    </Border>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MinG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding HeaveMinGString, ElementName=Root}" />

                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[MaxG]}" />

                            <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       Text="{Binding HeaveMaxGString, ElementName=Root}" />

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[SeatOfPantsEffect]}"
                                HelpTopic="advanced/seat-belt-tensioner/#seat-of-pants-effect">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <controls:MairaComboBox x:Name="SeatOfPantsMode_MairaComboBox"
                                            Label="{Binding Localization[AxisMode]}"
                                            ContextSwitches="{Binding Settings.SeatBeltTensionerSeatOfPantsModeContextSwitches}"
                                            SelectionChanged="SeatOfPantsMode_MairaComboBox_SelectionChanged"
                                            SelectedValue="{Binding Settings.SeatBeltTensionerSeatOfPantsMode, Mode=TwoWay}" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <controls:MairaKnob Label="{Binding Localization[MinimumThreshold]}"
                                        Value="{Binding Settings.SteeringEffectsSeatOfPantsMinimumThreshold, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SteeringEffectsSeatOfPantsMinimumThresholdString}"
                                        ClickStepSize="0.1"
                                        DragStepSize="0.00868"
                                        ContextSwitches="{Binding Settings.SteeringEffectsSeatOfPantsMinimumThresholdContextSwitches}"
                                        DefaultValue="0" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[MaximumThreshold]}"
                                        Value="{Binding Settings.SteeringEffectsSeatOfPantsMaximumThreshold, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SteeringEffectsSeatOfPantsMaximumThresholdString}"
                                        ClickStepSize="0.1"
                                        DragStepSize="0.00868"
                                        ContextSwitches="{Binding Settings.SteeringEffectsSeatOfPantsMaximumThresholdContextSwitches}"
                                        DefaultValue="3" />

                    <controls:MairaComboBox x:Name="SeatOfPantsAlgorithm_MairaComboBox"
                                            Margin="0,10,0,0"
                                            Label="{Binding Localization[Algorithm]}"
                                            SelectedValue="{Binding Settings.SteeringEffectsSeatOfPantsAlgorithm, Mode=TwoWay}"
                                            ContextSwitches="{Binding Settings.SteeringEffectsSeatOfPantsAlgorithmContextSwitches}" />

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <controls:MairaKnob Label="{Binding Localization[Amplitude]}"
                                        Value="{Binding Settings.SeatBeltTensionerSeatOfPantsAmplitude, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSeatOfPantsAmplitudeString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0208"
                                        DefaultValue="120" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Curve]}"
                                        Value="{Binding Settings.SeatBeltTensionerSeatOfPantsCurve, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerSeatOfPantsCurveString}"
                                        ClickStepSize="0.01"
                                        DragStepSize="0.000347"
                                        DefaultValue="0.25"
                                        ShowCurve="True"
                                        ContextSwitches="{Binding Settings.SeatBeltTensionerSeatOfPantsCurveContextSwitches}" />

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[VibrationEffects]}"
                                HelpTopic="advanced/seat-belt-tensioner/#vibration-effects">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <controls:MairaSwitch Label="{Binding Localization[ABSWheelLock]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerABSEnabled, Mode=TwoWay}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Frequency]}"
                                        Value="{Binding Settings.SeatBeltTensionerABSFrequency, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerABSFrequencyString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0026"
                                        DefaultValue="10" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Amplitude]}"
                                        Value="{Binding Settings.SeatBeltTensionerABSAmplitude, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerABSAmplitudeString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0104"
                                        DefaultValue="30" />

                    <controls:MairaButton x:Name="ABSTest_MairaButton"
                                          Margin="0,10,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="ABSTest_MairaButton_Click" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <controls:MairaSwitch Label="{Binding Localization[WheelSlip]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerWheelSlipEnabled, Mode=TwoWay}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Frequency]}"
                                        Value="{Binding Settings.SeatBeltTensionerWheelSlipFrequency, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerWheelSlipFrequencyString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0026"
                                        DefaultValue="11" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Amplitude]}"
                                        Value="{Binding Settings.SeatBeltTensionerWheelSlipAmplitude, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerWheelSlipAmplitudeString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0104"
                                        DefaultValue="30" />

                    <controls:MairaButton x:Name="WheelSlipTest_MairaButton"
                                          Margin="0,10,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="WheelSlipTest_MairaButton_Click" />

                </StackPanel>

                <StackPanel Grid.Column="4">

                    <controls:MairaSwitch Label="{Binding Localization[RumbleStrip]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerRumbleEnabled, Mode=TwoWay}" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Frequency]}"
                                        Value="{Binding Settings.SeatBeltTensionerRumbleFrequency, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerRumbleFrequencyString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0026"
                                        DefaultValue="12" />

                    <controls:MairaKnob Margin="0,10,0,0"
                                        Label="{Binding Localization[Amplitude]}"
                                        Value="{Binding Settings.SeatBeltTensionerRumbleAmplitude, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerRumbleAmplitudeString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.0104"
                                        DefaultValue="30" />

                    <controls:MairaButton x:Name="RumbleTest_MairaButton"
                                          Margin="0,10,0,0"
                                          Label="{Binding Localization[Test]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/vibrate.png"
                                          Click="RumbleTest_MairaButton_Click" />

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[MotorOutput]}"
                                HelpTopic="advanced/seat-belt-tensioner/#motor-output">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Border.Normal}"
                            Background="{DynamicResource Brush.Background.Popup}"
                            CornerRadius="5">

                        <Grid>

                            <Image x:Name="LeftShoulderGraph_Image"
                                   Width="1600"
                                   Height="251"
                                   HorizontalAlignment="Right"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <TextBlock x:Name="LeftShoulderABS_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[ABSWheelLock]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#ffdd44"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="LeftShoulderWheelSlip_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[WheelSlip]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#44ddff"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="LeftShoulderRumble_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[RumbleStrip]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#88ff88"
                                       Visibility="Collapsed" />

                        </Grid>

                    </Border>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[LeftShoulder]}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Border.Normal}"
                            Background="{DynamicResource Brush.Background.Popup}"
                            CornerRadius="5">

                        <Grid>

                            <Image x:Name="RightShoulderGraph_Image"
                                   Width="1600"
                                   Height="251"
                                   HorizontalAlignment="Right"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <TextBlock x:Name="RightShoulderABS_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[ABSWheelLock]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#ffdd44"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="RightShoulderWheelSlip_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[WheelSlip]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#44ddff"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="RightShoulderRumble_TextBlock"
                                       Style="{StaticResource MairaTextBlockStyle}"
                                       Text="{Binding Localization[RumbleStrip]}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0"
                                       Foreground="#88ff88"
                                       Visibility="Collapsed" />

                        </Grid>

                    </Border>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[RightShoulder]}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
