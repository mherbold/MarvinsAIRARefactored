<UserControl x:Class="MarvinsAIRARefactored.Pages.TyphoonWindPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Connection]}"
                                HelpTopic="advanced/typhoon-wind/#connection">

            <StackPanel>

                <StackPanel Orientation="Horizontal">

                    <controls:MairaSwitch x:Name="ConnectToWind_MairaSwitch"
                                          Grid.Row="0"
                                          Label="{Binding Localization[ConnectToWind]}"
                                          Toggled="ConnectToWind_MairaSwitch_Toggled" />

                    <controls:MairaButton x:Name="RetryDevice_MairaButton"
                                          Margin="20,0,0,0"
                                          Label="{Binding Localization[Retry]}"
                                          Visibility="Collapsed"
                                          d:Visibility="Visible"
                                          Click="RetryDevice_MairaButton_Click" />

                </StackPanel>

                <controls:MairaSwitch x:Name="ConnectOnStartup_MairaSwitch"
                                      Grid.Row="1"
                                      Margin="0,10,0,0"
                                      Label="{Binding Localization[ConnectToWindOnStartup]}"
                                      IsOn="{Binding Settings.TyphoonWindConnectOnStartup, Mode=TwoWay}" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Settings]}"
                                HelpTopic="advanced/typhoon-wind/#settings">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[MasterWindPower]}"
                                    Value="{Binding Settings.TyphoonWindMasterWindPower, Mode=TwoWay}"
                                    ValueString="{Binding Settings.TyphoonWindMasterWindPowerString}"
                                    ClickStepSize="0.01"
                                    DragStepSize="0.000174"
                                    ContextSwitches="{Binding Settings.TyphoonWindMasterWindPowerContextSwitches}"
                                    PlusButtonMappings="{Binding Settings.TyphoonWindMasterWindPowerPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.TyphoonWindMasterWindPowerMinusButtonMappings}"
                                    DefaultValue="0" />

                <controls:MairaKnob Grid.Column="2"
                                    Label="{Binding Localization[MinimumSpeed]}"
                                    Value="{Binding Settings.TyphoonWindMinimumSpeed, Mode=TwoWay}"
                                    ValueString="{Binding Settings.TyphoonWindMinimumSpeedString}"
                                    ClickStepSize="0.5"
                                    DragStepSize="0.0174"
                                    ContextSwitches="{Binding Settings.TyphoonWindMinimumSpeedContextSwitches}"
                                    PlusButtonMappings="{Binding Settings.TyphoonWindMinimumSpeedPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.TyphoonWindMinimumSpeedMinusButtonMappings}"
                                    DefaultValue="0" />

                <controls:MairaKnob Grid.Column="4"
                                    Label="{Binding Localization[TyphoonWindCurving]}"
                                    Value="{Binding Settings.TyphoonWindCurving, Mode=TwoWay}"
                                    ValueString="{Binding Settings.TyphoonWindCurvingString}"
                                    ClickStepSize="0.01"
                                    DragStepSize="0.000174"
                                    ContextSwitches="{Binding Settings.TyphoonWindCurvingContextSwitches}"
                                    PlusButtonMappings="{Binding Settings.TyphoonWindCurvingPlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.TyphoonWindCurvingMinusButtonMappings}"
                                    DefaultValue="0.5" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[FanPower]}"
                                HelpTopic="advanced/typhoon-wind/#fan-power">

            <StackPanel>

            <Grid Height="200"
                  HorizontalAlignment="Center">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0"
                      Grid.RowSpan="3"
                      Grid.Column="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaDualSlider Grid.Column="0"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed1}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed1String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower1}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower1String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="2"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed2}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed2String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower2}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower2String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="4"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed3}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed3String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower3}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower3String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="6"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed4}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed4String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower4}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower4String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="8"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed5}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed5String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower5}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower5String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="10"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed6}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed6String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower6}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower6String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="12"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed7}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed7String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower7}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower7String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="14"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed8}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed8String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower8}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower8String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="16"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed9}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed9String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower9}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower9String}"
                                              HorizontalAlignment="Center" />

                    <controls:MairaDualSlider Grid.Column="18"
                                              LeftMinValue="0" LeftMaxValue="100"
                                              LeftValue="{Binding Settings.TyphoonWindSpeed10}"
                                              LeftValueString="{Binding Settings.TyphoonWindSpeed10String}"
                                              RightValue="{Binding Settings.TyphoonWindFanPower10}"
                                              RightValueString="{Binding Settings.TyphoonWindFanPower10String}"
                                              HorizontalAlignment="Center" />

                </Grid>

                <TextBlock x:Name="SpeedLabel_TextBlock"
                           Grid.Row="0"
                           Grid.Column="4"
                           Style="{StaticResource MairaTextBlockStyle}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="4"
                           Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[FanPower]}" />

            </Grid>

            <controls:MairaButton Margin="0,20,0,0"
                                  HorizontalAlignment="Center"
                                  LabelOnRight="True"
                                  IsSmall="True"
                                  Label="{Binding Localization[ResetFanPowerCurveToDefaults]}"
                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/reset.png"
                                  Click="ResetFanPowerCurveToDefaults_MairaButton_Click" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[FanStatus]}"
                                HelpTopic="advanced/typhoon-wind/#fan-status">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[LeftFan]}"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Grid.Row="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           Text="{Binding Localization[RightFan]}"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="0"
                            Grid.Row="2"
                            VerticalAlignment="Center">

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               HorizontalAlignment="Center">
                        
                        <Run x:Name="LeftFanPower_TextBlock"
                             FontSize="30"
                             Foreground="#ff5b2e"
                             d:Text="35" />
                        
                        <Run Text="{Binding Localization[Percent], Mode=OneWay}"
                             FontSize="20"
                             Foreground="#979797" />

                    </TextBlock>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               HorizontalAlignment="Center">
                        
                        <Run x:Name="LeftFanRPM_TextBlock"
                             FontSize="30"
                             Foreground="#ff5b2e"
                             d:Text="1250" />
                        
                        <Run Text="{Binding Localization[RPM], Mode=OneWay}"
                             FontSize="20"
                             Foreground="#979797" />

                    </TextBlock>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.Row="2"
                            VerticalAlignment="Center">

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               HorizontalAlignment="Center">
                        
                        <Run x:Name="RightFanPower_TextBlock"
                             FontSize="30"
                             Foreground="#ff5b2e"
                             d:Text="35" />
                        
                        <Run Text="{Binding Localization[Percent], Mode=OneWay}"
                             FontSize="20"
                             Foreground="#979797" />

                    </TextBlock>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               HorizontalAlignment="Center">

                        <Run x:Name="RightFanRPM_TextBlock"
                             FontSize="30"
                             Foreground="#ff5b2e"
                             d:Text="1250" />
                        
                        <Run Text="{Binding Localization[RPM], Mode=OneWay}"
                             FontSize="20"
                             Foreground="#979797" />

                    </TextBlock>

                </StackPanel>

                <controls:MairaButton Grid.Column="0"
                                      Grid.Row="5"
                                      Label="{Binding Localization[Test]}"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/fan.png"
                                      BlinkIcon="/MarvinsAIRARefactored;component/Artwork/Buttons/fan-orange.png"
                                      Click="LeftTest_MairaButton_Click" />

                <controls:MairaButton Grid.Column="1"
                                      Grid.Row="5"
                                      Label="{Binding Localization[Test]}"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/fan.png"
                                      BlinkIcon="/MarvinsAIRARefactored;component/Artwork/Buttons/fan-orange.png"
                                      Click="RightTest_MairaButton_Click" />

            </Grid>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
