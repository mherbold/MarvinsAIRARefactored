<UserControl x:Class="MarvinsAIRARefactored.Pages.AppSettingsPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Language]}"
                                Tag="HideIfAdminBoxx"
                                HelpTopic="advanced/app-settings/#language">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaComboBox x:Name="Language_MairaComboBox"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="1"
                                        FlowDirection="LeftToRight"
                                        SelectedValue="{Binding Settings.AppCurrentLanguageCode, Mode=TwoWay}" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[DefaultPage]}"
                                Tag="HideIfAdminBoxx"
                                HelpTopic="advanced/app-settings/#default-page">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaComboBox x:Name="DefaultPage_MairaComboBox"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="1"
                                        SelectedValue="{Binding Settings.AppDefaultPage, Mode=TwoWay}" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[AppWindow]}"
                                HelpTopic="advanced/app-settings/#app-window">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:MairaSwitch Grid.Row="0"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0"
                                      IsOn="{Binding Settings.AppShowSplashScreen, Mode=TwoWay}"
                                      Label="{Binding Localization[ShowSplashScreen]}" />

                <controls:MairaSwitch Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppTopmostWindowEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[TopmostWindow]}" />

                <controls:MairaSwitch Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppRememberWindowPositionAndSize, Mode=TwoWay}"
                                      Label="{Binding Localization[RememberWindowPositionAndSize]}" />

                <controls:MairaSwitch Grid.Row="3"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppStartWithWindows, Mode=TwoWay}"
                                      Label="{Binding Localization[StartWithWindows]}" />

                <controls:MairaSwitch Grid.Row="4"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppStartMinimized, Mode=TwoWay}"
                                      Label="{Binding Localization[StartMinimized]}" />

                <controls:MairaSwitch Grid.Row="5"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppMinimizeToSystemTray, Mode=TwoWay}"
                                      Label="{Binding Localization[MinimizeToSystemTray]}" />

                <controls:MairaSwitch Grid.Row="6"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppMinimizeInsteadOfClosing, Mode=TwoWay}"
                                      Label="{Binding Localization[MinimizeInsteadOfClosing]}" />

                <controls:MairaSwitch Grid.Row="7"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Margin="0,10,0,0"
                                      IsOn="{Binding Settings.AppLightThemeEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[LightTheme]}" />

                <controls:MairaKnob Grid.Row="0"
                                    Grid.Column="4"
                                    Grid.RowSpan="5"
                                    Label="{Binding Localization[UIScale]}"
                                    Value="{Binding Settings.AppUIScale, Mode=TwoWay}"
                                    ValueString="{Binding Settings.AppUIScaleString}"
                                    ClickStepSize="0.05"
                                    DragStepSize="0.00026"
                                    DefaultValue="1" />

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[CloudService]}"
                                Tag="HideIfAdminBoxx"
                                HelpTopic="advanced/app-settings/#cloud-service">

            <StackPanel>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaSwitch Grid.Column="0"
                                          Grid.ColumnSpan="3"
                                          IsOn="{Binding Settings.AppCheckForUpdates, Mode=TwoWay}"
                                          Label="{Binding Localization[CheckForUpdates]}" />

                    <controls:MairaKnob Grid.Column="4"
                                        Label="{Binding Localization[UpdateCheckInterval]}"
                                        Value="{Binding Settings.AppUpdateCheckIntervalHours, Mode=TwoWay}"
                                        ValueString="{Binding Settings.AppUpdateCheckIntervalHoursString}"
                                        ClickStepSize="1"
                                        DragStepSize="0.029"
                                        DefaultValue="1" />

                </Grid>

                <controls:MairaButton x:Name="CheckNow_MairaButton"
                                      Margin="0,20,0,0"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/search.png"
                                      Label="{Binding Localization[CheckNow]}"
                                      Click="CheckNow_MairaButton_Click" />

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[CPUAffinity]}"
                                Tag="HideIfAdminBoxx"
                                HelpTopic="advanced/app-settings/#cpu-affinity">

            <UniformGrid x:Name="CpuAffinityPanel"
                         Columns="4">

                <!-- CPU affinity checkboxes will be dynamically added here -->

            </UniformGrid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[Wizard]}"
                                HelpTopic="advanced/app-settings/#wizard"
                                Tag="HideIfAdminBoxx">

            <controls:MairaButton x:Name="LaunchWizard_MairaButton"
                                  Label="{Binding Localization[LaunchWizard]}"
                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/wand.png"
                                  Click="LaunchWizard_MairaButton_Click" />

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization.Upper[WindowVisibility]}"
                                Tag="HideIfAdminBoxx"
                                HelpTopic="advanced/app-settings/#window-visibility">

            <controls:MairaMappableButton x:Name="ToggleMainWindow_MairaMappableButton"
                                          Label="{Binding Localization[ShowHideWindow]}"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/eye.png"
                                          ButtonMappings="{Binding Settings.AppToggleMainWindowButtonMappings}"
                                          Click="ToggleMainWindow_MairaMappableButton_Click" />

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
