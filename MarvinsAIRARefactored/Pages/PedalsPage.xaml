                                    Value="{Binding Settings.PedalsBrakeStrength3, Mode=TwoWay}"
                                    ValueString="{Binding Settings.PedalsBrakeStrength3String}"
                                    ClickStepSize="0.05"
                                    DragStepSize="0.000174"
                                    PlusButtonMappings="{Binding Settings.PedalsBrakeStrength3PlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.PedalsBrakeStrength3MinusButtonMappings}"
                                    DefaultValue="1" />

                <controls:MairaMappableButton x:Name="BrakeTest3_MairaMappableButton"
