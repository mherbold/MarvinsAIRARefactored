                                              ButtonMappings="{Binding Settings.PedalsBrakeTest2ButtonMappings}"
                                              Click="BrakeTest2_MairaMappableButton_Click"
                                              IsSmall="True"
                                              VerticalAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           Text="3"
                           FontSize="30" />

                <controls:MairaComboBox x:Name="BrakeEffect3_MairaComboBox"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        SelectedValue="{Binding Settings.PedalsBrakeEffect3, Mode=TwoWay}" />

                <controls:MairaKnob Grid.Row="4"
