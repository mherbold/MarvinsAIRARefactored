                                              ButtonMappings="{Binding Settings.PedalsClutchTest2ButtonMappings}"
                                              Click="ClutchTest2_MairaMappableButton_Click"
                                              IsSmall="True"
                                              VerticalAlignment="Center" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Style="{StaticResource MairaTextBlockStyle}"
                           Text="3"
                           FontSize="30"
                           VerticalAlignment="Bottom"
                           Padding="0,0,0,2" />

                <controls:MairaComboBox x:Name="ClutchEffect3_MairaComboBox"
                                        Grid.Row="4"
                                        Grid.Column="2"
                                        SelectedValue="{Binding Settings.PedalsClutchEffect3, Mode=TwoWay}" />

                <controls:MairaKnob Grid.Row="4"
                                    Grid.Column="4"
                                    Value="{Binding Settings.PedalsClutchStrength3, Mode=TwoWay}"
                                    ValueString="{Binding Settings.PedalsClutchStrength3String}"
                                    ClickStepSize="0.05"
                                    DragStepSize="0.000174"
                                    PlusButtonMappings="{Binding Settings.PedalsClutchStrength3PlusButtonMappings}"
                                    MinusButtonMappings="{Binding Settings.PedalsClutchStrength3MinusButtonMappings}"
                                    DefaultValue="1" />

                <controls:MairaMappableButton x:Name="ClutchTest3_MairaMappableButton"
