<UserControl x:Class="MarvinsAIRARefactored.Controls.MairaWindSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             mc:Ignorable="d"
             d:Width="Auto"
             d:Height="Auto">
    
    <StackPanel Orientation="Vertical" Margin="5,0">
            <Border BorderBrush="White" BorderThickness="2" Background="#FF111111" Padding="0,4,0,0" CornerRadius="4">
                <TextBox BorderThickness="0"
                    
                     Background="#FF111111"
                     Foreground="White"
                     TextAlignment="Center"
                     Text="{Binding TargetSpeedKPH, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                     Width="50" Height="30"
                     HorizontalAlignment="Center"
                     PreviewTextInput="TextBox_Wind_PreviewTextInput"/>
            </Border>
            <Slider 
                Orientation="Vertical"
                Height="120"
                HorizontalAlignment="Center"
                Minimum="0"
                Maximum="320"
                SmallChange="1"
                LargeChange="2"
                ValueChanged="Slider_Wind_ValueChanged"
                Value="{Binding FanPower, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                MouseLeave="Slider_Wind_01_MouseLeave"
                LostFocus="Slider_Wind_01_LostFocus"
                 PreviewMouseLeftButtonDown="Slider_MouseDown">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track" VerticalAlignment="Stretch">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{x:Null}"
                                              Background="{Binding TrackBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              BorderBrush="White"
                                              BorderThickness="1"
                                              Width="6"
                                              IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{x:Null}"
                                              Background="{Binding TrackBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              BorderBrush="White"
                                              BorderThickness="1"
                                              Width="6"
                                              IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="30" Height="15" Background="#FF111111">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF111111"
                                                    BorderThickness="2"
                                                    BorderBrush="White"
                                                    CornerRadius="5"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>

            <Border Background="#FF111111"
                BorderBrush="White"
                BorderThickness="2"
                CornerRadius="3"
                Width="40"
                Height="40">
            <Label Content="{Binding FanPower, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                   HorizontalAlignment="Center"
                   Background="Transparent"
                   Foreground="White"/>
            </Border>
        </StackPanel>
    </UserControl>