<Window x:Class="MarvinsAIRARefactored.Windows.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
        xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
        mc:Ignorable="d"
        Title="MAIRA Setup Wizard"
        Icon="/Artwork/AppIcon/maira-universal.ico"
        Width="850"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </Window.DataContext>

    <Grid Margin="20,40,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left 2/3: all step panels -->
        <StackPanel Grid.Column="0"
                    Margin="0,0,20,40">

            <!-- Step 0: Welcome / Skip -->
            <StackPanel x:Name="Step0_Panel">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Text="Greetings, Racer!"
                           Margin="0,0,0,16" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Text="I'm Marvin the Wizard, and I'm here to help you tame the mighty MAIRA!" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="With a wave of my checkered flag, I'll guide you through the most important settings so you can get on track as fast as possible. &#x1F3C1;&#x2728;" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"
                           Text="Shall we begin, or are you an experienced wizard yourself and prefer to configure everything manually?" />

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          x:Name="UseWizard_MairaButton"
                                          Label="Let's go!"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="UseWizard_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          x:Name="SkipWizard_MairaButton"
                                          Label="Skip"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                          Click="SkipWizard_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 1: Theme -->
            <StackPanel x:Name="Step1_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="App Theme"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="Choose whether you prefer a light or dark theme. Toggle the switch below to preview the change live." />

                <controls:MairaSwitch x:Name="LightTheme_MairaSwitch"
                                      Margin="0,0,0,30"
                                      IsOn="{Binding Settings.AppLightThemeEnabled, Mode=TwoWay}"
                                      Label="{Binding Localization[LightTheme]}" />

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          x:Name="Step1Next_MairaButton"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 2: Steering Wheel Device -->
            <StackPanel x:Name="Step2_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Steering Wheel"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="Select your force-feedback steering wheel from the list below." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x1F4A1;" /><Run Text=" Don't see your wheel? Make sure it is powered on and connected, then the list will refresh automatically." />
                </TextBlock>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x1F4A1;" /><Run Text=" Fanatec users: Fanatec wheels typically appear as two separate devices in the list. If the one you selected doesn't work, try selecting the other one!" />
                </TextBlock>

                <controls:MairaComboBox x:Name="WizardSteeringDevice_MairaComboBox"
                                        Margin="0,0,0,30"
                                        Label="{Binding Localization[SteeringDevice]}"
                                        SelectedValue="{Binding Settings.RacingWheelSteeringDeviceGuid, Mode=TwoWay}" />

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 3: Wheel Force -->
            <StackPanel x:Name="Step3_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Maximum Wheel Force"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="Enter the maximum force your wheelbase is capable of producing, in Newton-meters (Nm). MAIRA uses this value to correctly scale all force feedback output for your hardware." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x1F4A1;" /><Run Text=" We've made our best guess based on your selected wheel — but feel free to adjust it if needed." />
                </TextBlock>

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x26A0;" /><Run Text=" Important: If you have already limited your wheel's maximum torque output inside your wheel manufacturer's software (e.g., Fanatec Wheel Control Panel, Moza Pit House, etc.), enter that reduced value here instead of the hardware's physical maximum. MAIRA needs to know what your wheel will actually deliver, not what it's capable of in theory." />
                </TextBlock>

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        x:Name="WizardWheelForce_MairaKnob"
                                        Label="{Binding Localization[WheelForce]}"
                                        Value="{Binding Settings.RacingWheelWheelForce, Mode=TwoWay}"
                                        ValueString="{Binding Settings.RacingWheelWheelForceString}"
                                        StepSize="1"
                                        ContextSwitches="{Binding Settings.RacingWheelWheelForceContextSwitches}"
                                        DefaultValue="5" />
                </Grid>

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 4: Strength Button Mapping -->
            <StackPanel x:Name="Step4_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Strength Controls"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="MAIRA lets you bind physical buttons on your wheel or controller to raise and lower the Force Feedback Strength on the fly — without ever leaving the cockpit." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="Click the - and + buttons below to assign inputs to each one. This step is optional — you can skip it and set up bindings later from the Racing Wheel page." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x1F4A1;" /><Run Text=" Once an input is mapped, the button border will turn orange to confirm it." />
                </TextBlock>

                <Grid HorizontalAlignment="Left"
                      Margin="0,12,0,30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaMappableButton Grid.Column="0"
                                                  x:Name="StrengthMinus_MairaMappableButton"
                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/minus.png"
                                                  DefaultFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-minus-default.png"
                                                  MappedFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-minus-mapped.png"
                                                  PressedFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-minus-pressed.png"
                                                  ButtonMappings="{Binding Settings.RacingWheelStrengthMinusButtonMappings}"
                                                  Click="StrengthMinus_MairaMappableButton_Click" />

                    <Border Grid.Column="1"
                            BorderThickness="0,2,0,2"
                            BorderBrush="Black"
                            Padding="20,0,20,0"
                            Margin="0,1,0,1">

                        <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Text="Strength"
                                   VerticalAlignment="Center" />
                    </Border>

                    <controls:MairaMappableButton Grid.Column="2"
                                                  x:Name="StrengthPlus_MairaMappableButton"
                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/plus.png"
                                                  DefaultFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-plus-default.png"
                                                  MappedFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-plus-mapped.png"
                                                  PressedFrame="/MarvinsAIRARefactored;component/Artwork/Buttons/knob-plus-pressed.png"
                                                  ButtonMappings="{Binding Settings.RacingWheelStrengthPlusButtonMappings}"
                                                  Click="StrengthPlus_MairaMappableButton_Click" />

                </Grid>

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 5: Auto-Set question (Yes / No) -->
            <StackPanel x:Name="Step5_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Auto-Set Max Force"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="While you are driving on track, MAIRA continuously measures the actual peak torque your wheel produces. It uses that measurement to suggest the ideal Max Force value — one that uses your wheel's full range without ever clipping the signal." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="With the Auto-Set feature, you can bind a physical button on your wheel or controller to the Set action. Press it at any moment during a session and MAIRA will instantly update Max Force to match your measured peak — no menus, no interruptions." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="A companion Clear button resets the running measurement so you can start a fresh reading — useful if your car has gone off track or hit something." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30">
                    <Run Text="Would you like to set up the Auto-Set feature?" />
                </TextBlock>

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Yes"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Step5Yes_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="4"
                                          Label="No"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                          Click="Step5No_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 6: Auto-Set setup (Set / Clear / AutoTarget) -->
            <StackPanel x:Name="Step6_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Auto-Set Setup"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="First, adjust the Auto Target headroom to taste, then map your Set and Clear buttons." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24">
                    <Run Foreground="{StaticResource Brush.Accent}"
                         Text="&#x1F4A1;" /><Run Text=" Auto Target sets where in your wheel's force range the measured peak should land. Lower the target to keep more headroom above the peak; raise it to use more of the wheel's range." />
                </TextBlock>

                <Grid Margin="0,0,0,30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        x:Name="WizardAutoTarget_MairaKnob"
                                        Label="{Binding Localization[AutoTarget]}"
                                        Value="{Binding Settings.RacingWheelAutoMargin, Mode=TwoWay}"
                                        ValueString="{Binding Settings.RacingWheelAutoMarginString}"
                                        StepSize="0.01"
                                        ContextSwitches="{Binding Settings.RacingWheelAutoMarginContextSwitches}"
                                        PlusButtonMappings="{Binding Settings.RacingWheelAutoMarginPlusButtonMappings}"
                                        MinusButtonMappings="{Binding Settings.RacingWheelAutoMarginMinusButtonMappings}"
                                        DefaultValue="0"
                                        Reverse="True" />

                    <controls:MairaMappableButton Grid.Column="2"
                                                  x:Name="WizardSet_MairaMappableButton"
                                                  Label="{Binding Localization[Set]}"
                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/set.png"
                                                  ButtonMappings="{Binding Settings.RacingWheelSetButtonMappings}"
                                                  Click="WizardSet_MairaMappableButton_Click" />

                    <controls:MairaMappableButton Grid.Column="4"
                                                  x:Name="WizardClear_MairaMappableButton"
                                                  Label="{Binding Localization[Clear]}"
                                                  Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                                  ButtonMappings="{Binding Settings.RacingWheelClearButtonMappings}"
                                                  Click="WizardClear_MairaMappableButton_Click" />

                </Grid>

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Step 7: FFB Style -->
            <StackPanel x:Name="Step7_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="Algorithm"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Text="How do you like your force feedback to feel? Move the slider below to tell MAIRA your preference and it will configure the algorithm, detail and smoothing settings to match." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="Don't worry — you can always fine-tune everything manually on the Racing Wheel page later." />

                <!-- Slider labels row -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Text="&#x1F4A4; Smooth Feeling"
                               HorizontalAlignment="Left" />

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Text="Normal"
                               HorizontalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource MairaTextBlockStyle}"
                               Text="Boost Details &#x26A1;"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- The slider -->
                <Slider x:Name="FfbStyle_Slider"
                        Minimum="-3"
                        Maximum="3"
                        SmallChange="1"
                        LargeChange="1"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"
                        Value="0"
                        Margin="0,0,0,8"
                        ValueChanged="FfbStyle_Slider_ValueChanged" />

                <!-- Live description of the current position -->
                <TextBlock x:Name="FfbStyleName_TextBlock"
                           Style="{StaticResource MairaTextBlockStyle}"
                           FontWeight="Bold"
                           Margin="0,0,0,4"
                           Text="Normal" />

                <TextBlock x:Name="FfbStyleDescription_TextBlock"
                           Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"
                           Text="Balanced detail and smoothness." />

                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaButton Grid.Column="0"
                                          Label="Prev"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/prev.png"
                                          Click="Prev_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="2"
                                          Label="Next"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/next.png"
                                          Click="Step7Apply_MairaButton_Click" />

                    <controls:MairaButton Grid.Column="4"
                                          Label="Skip"
                                          Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/clear.png"
                                          Click="Next_MairaButton_Click" />
                </Grid>

            </StackPanel>

            <!-- Final Step: Thank you -->
            <StackPanel x:Name="StepFinal_Panel"
                        Visibility="Collapsed">

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           Text="You're all set!"
                           Margin="0,0,0,20" />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Text="Thank you for trying MAIRA! The wizard is now complete." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30"
                           Text="You can re-run this wizard at any time by visiting the App Settings page and clicking the &quot;Launch Wizard&quot; button." />

                <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30">
                    <Run Text="New to MAIRA? Click " /><Hyperlink Click="DocumentationLink_Click"><Run Text="here" /></Hyperlink><Run Text=" to open the documentation and learn about the common controls." />
                </TextBlock>

                <controls:MairaButton HorizontalAlignment="Center"
                                      x:Name="Close_MairaButton"
                                      Label="Close"
                                      Icon="/MarvinsAIRARefactored;component/Artwork/Buttons/set.png"
                                      Click="Close_MairaButton_Click" />

            </StackPanel>

        </StackPanel>

        <!-- Right 1/3: wizard image, swaps to thumbs-up on final step -->
        <Grid Grid.Column="1">

            <Image x:Name="WizardImage_Normal"
                   Source="/MarvinsAIRARefactored;component/Artwork/Misc/wizard.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center" />

            <Image x:Name="WizardImage_ThumbsUp"
                   Source="/MarvinsAIRARefactored;component/Artwork/Misc/wizard-two-thumbs-up.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" />

        </Grid>

    </Grid>

</Window>