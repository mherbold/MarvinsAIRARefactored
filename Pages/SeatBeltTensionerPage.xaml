<UserControl x:Class="MarvinsAIRARefactored.Pages.SeatBeltTensionerPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MarvinsAIRARefactored.Pages"
             xmlns:controls="clr-namespace:MarvinsAIRARefactored.Controls"
             xmlns:datacontext="clr-namespace:MarvinsAIRARefactored.DataContext"
             mc:Ignorable="d"
             d:DesignWidth="800">

    <UserControl.DataContext>
        <Binding Source="{x:Static datacontext:DataContext.Instance}" />
    </UserControl.DataContext>

    <StackPanel>

        <controls:MairaGroupBox Label="{Binding Localization[Connection_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#connection">

            <StackPanel>
                <controls:MairaSwitch x:Name="ConnectToSbt_MairaSwitch"
                                      Label="{Binding Localization[ConnectToSBT]}"
                                      Toggled="ConnectToSbt_MairaSwitch_Toggled" />

                <controls:MairaSwitch x:Name="ConnectOnStartup_MairaSwitch"
                                      Margin="0,10,0,0"
                                      Label="{Binding Localization[ConnectToSBTOnStartup]}"
                                      IsOn="{Binding Settings.SeatBeltTensionerEnabled, Mode=TwoWay}" />
            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[Calibration_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#calibration">

            <StackPanel>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[MinimumAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerMinimum, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMinimumString}"
                                        StepSize="1"
                                        DefaultValue="60" />

                    <controls:MairaKnob Grid.Column="2"
                                        Label="{Binding Localization[NeutralAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerNeutral, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerNeutralString}"
                                        StepSize="1"
                                        DefaultValue="90" />

                    <controls:MairaKnob Grid.Column="4"
                                        Label="{Binding Localization[MaximumAngle]}"
                                        Value="{Binding Settings.SeatBeltTensionerMaximum, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMaximumString}"
                                        StepSize="1"
                                        DefaultValue="120" />

                </Grid>

                <Grid Margin="0,20,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MairaKnob Grid.Column="0"
                                        Label="{Binding Localization[MaxMotorSpeed]}"
                                        Value="{Binding Settings.SeatBeltTensionerMaxMotorSpeed, Mode=TwoWay}"
                                        ValueString="{Binding Settings.SeatBeltTensionerMaxMotorSpeedString}"
                                        StepSize="1"
                                        DefaultValue="25" />

                </Grid>

            </StackPanel>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[Surge_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#surge">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[MaxGForce]}"
                                    Value="{Binding Settings.SeatBeltTensionerSurgeMaxG, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SeatBeltTensionerSurgeMaxGString}"
                                    StepSize="0.1"
                                    DefaultValue="10"
                                    ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeMaxGContextSwitches}" />

                <StackPanel Grid.Column="2">

                    <controls:MairaSwitch Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSurgeSubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeSubtractGravityContextSwitches}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[Invert]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSurgeInvert, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSurgeInvertContextSwitches}" />

                </StackPanel>

                <Border Grid.Column="4"
                        BorderThickness="2"
                        BorderBrush="#666"
                        Background="#222"
                        CornerRadius="5">

                    <Image x:Name="SurgeGraph_Image"
                           Width="1200"
                           Height="251"
                           HorizontalAlignment="Right"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                </Border>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[Sway_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#sway">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[MaxGForce]}"
                                    Value="{Binding Settings.SeatBeltTensionerSwayMaxG, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SeatBeltTensionerSwayMaxGString}"
                                    StepSize="0.1"
                                    DefaultValue="10"
                                    ContextSwitches="{Binding Settings.SeatBeltTensionerSwayMaxGContextSwitches}" />

                <StackPanel Grid.Column="2">

                    <controls:MairaSwitch Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSwaySubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSwaySubtractGravityContextSwitches}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[Invert]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerSwayInvert, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerSwayInvertContextSwitches}" />

                </StackPanel>

                <Border Grid.Column="4"
                        BorderThickness="2"
                        BorderBrush="#666"
                        Background="#222"
                        CornerRadius="5">

                    <Image x:Name="SwayGraph_Image"
                           Width="1200"
                           Height="251"
                           HorizontalAlignment="Right"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                </Border>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[Heave_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#heave">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:MairaKnob Grid.Column="0"
                                    Label="{Binding Localization[MaxGForce]}"
                                    Value="{Binding Settings.SeatBeltTensionerHeaveMaxG, Mode=TwoWay}"
                                    ValueString="{Binding Settings.SeatBeltTensionerHeaveMaxGString}"
                                    StepSize="0.1"
                                    DefaultValue="10"
                                    ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveMaxGContextSwitches}" />

                <StackPanel Grid.Column="2">

                    <controls:MairaSwitch Label="{Binding Localization[SubtractGravity]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerHeaveSubtractGravity, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveSubtractGravityContextSwitches}" />

                    <controls:MairaSwitch Margin="0,10,0,0"
                                          Label="{Binding Localization[Invert]}"
                                          IsOn="{Binding Settings.SeatBeltTensionerHeaveInvert, Mode=TwoWay}"
                                          ContextSwitches="{Binding Settings.SeatBeltTensionerHeaveInvertContextSwitches}" />

                </StackPanel>

                <Border Grid.Column="4"
                        BorderThickness="2"
                        BorderBrush="#666"
                        Background="#222"
                        CornerRadius="5">

                    <Image x:Name="HeaveGraph_Image"
                           Width="1200"
                           Height="251"
                           HorizontalAlignment="Right"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                </Border>

            </Grid>

        </controls:MairaGroupBox>

        <controls:MairaGroupBox Label="{Binding Localization[MotorOutput_UC]}"
                                HelpTopic="advanced/seat-belt-tensioner/#motor-output">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Border BorderThickness="2"
                            BorderBrush="#666"
                            Background="#222"
                            CornerRadius="5">

                        <Image x:Name="LeftShoulderGraph_Image"
                               Width="1600"
                               Height="251"
                               HorizontalAlignment="Right"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                    </Border>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[LeftShoulder]}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Border BorderThickness="2"
                            BorderBrush="#666"
                            Background="#222"
                            CornerRadius="5">

                        <Image x:Name="RightShoulderGraph_Image"
                               Width="1600"
                               Height="251"
                               HorizontalAlignment="Right"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                    </Border>

                    <TextBlock Style="{StaticResource MairaTextBlockStyle}"
                               Text="{Binding Localization[RightShoulder]}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />

                </StackPanel>

            </Grid>

        </controls:MairaGroupBox>

    </StackPanel>

</UserControl>
